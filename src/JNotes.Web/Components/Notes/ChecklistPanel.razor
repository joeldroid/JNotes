@* The checklist — items grouped by category.
   Interactive in NoteView (goes through NoteService); ChecklistNoteEditor sets ReadOnly, so it's just
   a live preview of the markdown being edited (inert checkboxes). This component only reports what
   the user did through its callback and renders whatever Body it's handed. Its root is meant to sit
   in a flex-column parent, where the list scrolls (jn-fill); in a plain block parent that class is
   harmless. *@
@{
    var sections = ChecklistMarkdownParser.ParseSections(Body);
}

<div class="jn-fill">
    @foreach (var section in sections)
    {
        @if (section.Title is not null)
        {
            <MudText Typo="Typo.overline" HtmlTag="h3" Color="Color.Secondary" Class="jn-check-heading">@section.Title</MudText>
        }
        <div class="jn-check-list">
            @foreach (var item in section.Items)
            {
                // @key carries _listVersion so a reorder rebuilds these rows from the model — see
                // OnItemCheckedAsync for why (Blazor's diff would otherwise leave the clicked
                // checkbox visually ticked at whatever row it landed on).
                <div class="jn-check-row @(ReadOnly ? "checklist-readonly" : "")" @key="(_listVersion, item.LineIndex)">
                    @* ReadOnly deliberately isn't `Disabled` (that greys the box out): MudCheckBox's own ReadOnly
                       blocks toggling, and .checklist-readonly also drops pointer events so a click on the label
                       can't toggle it either. *@
                    <MudCheckBox T="bool" Value="item.IsChecked" ValueChanged="@(isChecked => OnItemCheckedAsync(item.LineIndex, isChecked))"
                                 Disabled="Disabled" ReadOnly="ReadOnly" Color="Color.Primary" Dense="true">
                        <span class="@(item.IsChecked ? "jn-check-done" : null)">@item.Text</span>
                    </MudCheckBox>
                </div>
            }
            @if (section.Items.Count == 0)
            {
                <MudText Color="Color.Secondary" Class="jn-check-empty">Nothing here yet.</MudText>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Body { get; set; } = "";

    /// <summary>Disables every control — the view sets it while a save is in flight so clicks can't race.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Renders the list with checkboxes inert but styled normally. The editor uses this: once the user is editing the raw markdown, a second way to edit it just duplicates the UI.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public EventCallback<(int LineIndex, bool IsChecked)> OnItemChecked { get; set; }

    private int _listVersion;

    private async Task OnItemCheckedAsync(int lineIndex, bool isChecked)
    {
        if (ReadOnly)
        {
            return;
        }

        await OnItemChecked.InvokeAsync((lineIndex, isChecked));

        // Checking an item moves it, so the row that takes its old slot can render identically to
        // what the browser already toggled — Blazor's diff would then skip patching it and leave
        // the DOM checkbox ticked. Bumping the version changes every row's key, forcing a
        // rebuild from the model. (Also snaps the box back if the save failed.)
        _listVersion++;
    }
}
