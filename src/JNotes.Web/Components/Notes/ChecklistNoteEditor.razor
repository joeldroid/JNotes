<div class="d-flex justify-content-end mb-2">
    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showChecklist = !_showChecklist">
        @(_showChecklist ? "Hide checklist" : "Show checklist")
    </button>
</div>

<div class="row g-3">
    <div class="@(_showChecklist ? "col-12 col-lg-6" : "col-12")">
        <textarea class="form-control note-editor-textarea" aria-label="Checklist markdown"
                  value="@Body" @oninput="OnInput"></textarea>
    </div>
    @if (_showChecklist)
    {
        <div class="col-12 col-lg-6">
            @* Same fixed height as the textarea beside it; the panel's list scrolls, its add boxes stay pinned. *@
            <div class="border rounded p-3 d-flex flex-column note-editor-preview">
                <ChecklistPanel Body="@Body" OnItemChecked="OnItemCheckedAsync" OnAddItem="OnAddItemAsync" OnAddCategory="OnAddCategoryAsync" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Body { get; set; } = "";
    [Parameter] public EventCallback<string> BodyChanged { get; set; }

    private bool _showChecklist = true;

    private Task OnInput(ChangeEventArgs e) => BodyChanged.InvokeAsync(e.Value?.ToString() ?? "");

    // The panel's actions mutate the body in memory and hand it back through BodyChanged, so they
    // ride NoteEditor's ordinary content debounce/_saveGate instead of a disk read-modify-write that
    // would discard body edits still waiting on that debounce. The textarea renders the same Body,
    // so it stays in sync for free.
    private Task OnItemCheckedAsync((int LineIndex, bool IsChecked) change) =>
        BodyChanged.InvokeAsync(ChecklistMarkdownParser.SetItemChecked(Body, change.LineIndex, change.IsChecked));

    private Task OnAddItemAsync((string Text, int? CategoryHeadingLine) add) =>
        BodyChanged.InvokeAsync(ChecklistMarkdownParser.AppendItemsToCategory(Body, add.Text, add.CategoryHeadingLine));

    private Task OnAddCategoryAsync(string name) =>
        BodyChanged.InvokeAsync(ChecklistMarkdownParser.AddCategory(Body, name));
}
