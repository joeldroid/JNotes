<div class="d-flex justify-content-end mb-2">
    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showChecklist = !_showChecklist">
        @(_showChecklist ? "Hide checklist" : "Show checklist")
    </button>
</div>

<div class="row g-3">
    <div class="@(_showChecklist ? "col-12 col-lg-6" : "col-12")">
        <textarea class="form-control note-editor-textarea" aria-label="Checklist markdown"
                  value="@Body" @oninput="OnInput"></textarea>
    </div>
    @if (_showChecklist)
    {
        <div class="col-12 col-lg-6">
            @* Same fixed height as the textarea beside it; the panel's list scrolls internally. *@
            <div class="border rounded p-3 d-flex flex-column note-editor-preview">
                <ChecklistPanel Body="@Body" ReadOnly="true" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Body { get; set; } = "";
    [Parameter] public EventCallback<string> BodyChanged { get; set; }

    private bool _showChecklist = true;

    private Task OnInput(ChangeEventArgs e) => BodyChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
