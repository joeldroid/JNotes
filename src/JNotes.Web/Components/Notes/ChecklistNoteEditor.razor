<div class="d-flex align-items-center mb-2 flex-wrap gap-2">
    @if (_showRawMarkdown)
    {
        <MarkdownToolbar TargetTextarea="_textareaRef" />
    }
    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => _showRawMarkdown = !_showRawMarkdown">
        @(_showRawMarkdown ? "Hide raw markdown" : "Edit raw markdown")
    </button>
</div>

<div class="row g-3">
    <div class="@(_showRawMarkdown ? "col-12 col-lg-6" : "col-12")">
        <ul class="list-group mb-0">
            @foreach (var item in Items)
            {
                <li class="list-group-item">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@($"item-{item.LineIndex}")"
                               checked="@item.IsChecked" @onchange="() => ItemToggled.InvokeAsync(item.LineIndex)" />
                        <label class="form-check-label @(item.IsChecked ? "text-decoration-line-through text-body-secondary" : "")"
                               for="@($"item-{item.LineIndex}")">
                            @item.Text
                        </label>
                    </div>
                </li>
            }
            @if (Items.Count == 0)
            {
                <li class="list-group-item text-body-secondary">No checklist items yet — add some in the raw markdown.</li>
            }
        </ul>
    </div>
    @if (_showRawMarkdown)
    {
        <div class="col-12 col-lg-6">
            <textarea @ref="_textareaRef" class="form-control note-editor-textarea" aria-label="Raw checklist markdown"
                      value="@Body" @oninput="OnInput"></textarea>
            <div class="form-text">Add, remove, or reorder items here — new task-list lines (<code>- [ ] …</code>) become checkboxes on the left once saved.</div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Body { get; set; } = "";
    [Parameter] public EventCallback<string> BodyChanged { get; set; }
    [Parameter] public EventCallback<int> ItemToggled { get; set; }

    private bool _showRawMarkdown;
    private ElementReference _textareaRef;

    private IReadOnlyList<ChecklistItem> Items => ChecklistMarkdownParser.Parse(Body);

    private Task OnInput(ChangeEventArgs e) => BodyChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
