@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="d-flex flex-wrap gap-2">
    <div class="btn-group" role="group" aria-label="Markdown formatting">
        <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" title="Bold" @onclick="BoldAsync">B</button>
        <button type="button" class="btn btn-sm btn-outline-secondary fst-italic" title="Italic" @onclick="ItalicAsync">I</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Bulleted list" @onclick="BulletListAsync">☰ List</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Numbered list" @onclick="OrderedListAsync">1. List</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Insert table" @onclick="TableAsync">Table</button>
    </div>
    <div class="btn-group" role="group" aria-label="Diagrams">
        <button type="button" class="btn btn-sm btn-outline-secondary"
                title="Insert a left-to-right flow chart" aria-label="Insert a left-to-right flow chart"
                @onclick="FlowchartLeftToRightAsync">Flow →</button>
        <button type="button" class="btn btn-sm btn-outline-secondary"
                title="Insert a top-to-bottom flow chart" aria-label="Insert a top-to-bottom flow chart"
                @onclick="FlowchartTopToBottomAsync">Flow ↓</button>
    </div>
</div>

@code {
    private const string SampleTable = """


        | Header 1 | Header 2 |
        | --- | --- |
        | Cell 1 | Cell 2 |
        | Cell 3 | Cell 4 |

        """;

    private const string FlowchartLeftToRight = """


        ```mermaid
        flowchart LR
            A([Start]) --> B[Step one]
            B --> C{Decision}
            C -->|Yes| D([Done])
            C -->|No| B
        ```

        """;

    private const string FlowchartTopToBottom = """


        ```mermaid
        flowchart TD
            A([Start]) --> B[Step one]
            B --> C{Decision}
            C -->|Yes| D([Done])
            C -->|No| B
        ```

        """;

    // A getter, not an ElementReference: the parent's @ref is only assigned after the render that
    // passes it down, so a plain ElementReference parameter is still empty until the parent happens
    // to re-render (JS then receives an unresolved object and every button throws). Reading it at
    // click time always sees the captured element.
    [Parameter, EditorRequired] public Func<ElementReference> GetTargetTextarea { get; set; } = default!;

    private IJSObjectReference? _module;

    private async Task<IJSObjectReference> GetModuleAsync() =>
        _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/markdown-toolbar.js");

    private async Task BoldAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("wrapSelection", GetTargetTextarea(), "**", "**", "bold text");
    }

    private async Task ItalicAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("wrapSelection", GetTargetTextarea(), "*", "*", "italic text");
    }

    private async Task BulletListAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("toggleBulletList", GetTargetTextarea());
    }

    private async Task OrderedListAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("toggleOrderedList", GetTargetTextarea());
    }

    private async Task TableAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("insertAtCursor", GetTargetTextarea(), SampleTable);
    }

    private async Task FlowchartLeftToRightAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("insertAtCursor", GetTargetTextarea(), FlowchartLeftToRight);
    }

    private async Task FlowchartTopToBottomAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("insertAtCursor", GetTargetTextarea(), FlowchartTopToBottom);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit's already gone (e.g. tab closed/navigated away) — nothing to clean up.
            }
        }
    }
}
