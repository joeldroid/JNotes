@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="jn-toolbar">
    <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" aria-label="Markdown formatting">
        <MudButton title="Bold" aria-label="Bold" OnClick="BoldAsync"><strong>B</strong></MudButton>
        <MudButton title="Italic" aria-label="Italic" OnClick="ItalicAsync"><em>I</em></MudButton>
        <MudButton title="Bulleted list" OnClick="BulletListAsync" StartIcon="@Icons.Material.Filled.FormatListBulleted">List</MudButton>
        <MudButton title="Numbered list" OnClick="OrderedListAsync" StartIcon="@Icons.Material.Filled.FormatListNumbered">List</MudButton>
        <MudButton title="Insert table" OnClick="TableAsync" StartIcon="@Icons.Material.Filled.TableChart">Table</MudButton>
    </MudButtonGroup>
    <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" aria-label="Diagrams">
        <MudButton title="Insert a left-to-right flow chart" aria-label="Insert a left-to-right flow chart"
                   OnClick="FlowchartLeftToRightAsync">Flow →</MudButton>
        <MudButton title="Insert a top-to-bottom flow chart" aria-label="Insert a top-to-bottom flow chart"
                   OnClick="FlowchartTopToBottomAsync">Flow ↓</MudButton>
    </MudButtonGroup>
    @* MudFileUpload wraps the same InputFile the toolbar used before, so the picked file is still an
       IBrowserFile read over the circuit — no upload route. It draws no UI of its own here: the button
       below just opens its picker. *@
    <MudFileUpload T="IBrowserFile" @ref="_upload" Accept="image/png,image/jpeg,image/gif,image/webp"
                   OnFilesChanged="OnImageChosenAsync" Disabled="ImageBusy">
        <CustomContent Context="upload">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Disabled="ImageBusy"
                       StartIcon="@Icons.Material.Filled.Image"
                       title="Insert an image (you can also paste one into the note)"
                       OnClick="() => upload.OpenFilePickerAsync()">
                @(ImageBusy ? "Uploading…" : "Image")
            </MudButton>
        </CustomContent>
    </MudFileUpload>
</div>

@code {
    private const string SampleTable = """


        | Header 1 | Header 2 |
        | --- | --- |
        | Cell 1 | Cell 2 |
        | Cell 3 | Cell 4 |

        """;

    private const string FlowchartLeftToRight = """


        ```mermaid
        flowchart LR
            A([Start]) --> B[Step one]
            B --> C{Decision}
            C -->|Yes| D([Done])
            C -->|No| B
        ```

        """;

    private const string FlowchartTopToBottom = """


        ```mermaid
        flowchart TD
            A([Start]) --> B[Step one]
            B --> C{Decision}
            C -->|Yes| D([Done])
            C -->|No| B
        ```

        """;

    // A getter, not an ElementReference: the parent's @ref is only assigned after the render that
    // passes it down, so a plain ElementReference parameter is still empty until the parent happens
    // to re-render (JS then receives an unresolved object and every button throws). Reading it at
    // click time always sees the captured element.
    [Parameter, EditorRequired] public Func<ElementReference> GetTargetTextarea { get; set; } = default!;

    /// <summary>Raised with the file the user picked. The toolbar does no uploading itself — the editor owns that (paste shares the same path).</summary>
    [Parameter] public EventCallback<IBrowserFile> OnImageSelected { get; set; }

    /// <summary>True while an upload is in flight; disables the Image button.</summary>
    [Parameter] public bool ImageBusy { get; set; }

    private IJSObjectReference? _module;
    private MudFileUpload<IBrowserFile>? _upload;

    private async Task OnImageChosenAsync(InputFileChangeEventArgs e)
    {
        await OnImageSelected.InvokeAsync(e.File);

        // Reset the input once the upload is done, so choosing the same file again still raises OnFilesChanged.
        if (_upload is not null)
        {
            await _upload.ClearAsync();
        }
    }

    private async Task<IJSObjectReference> GetModuleAsync() =>
        _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/markdown-toolbar.js");

    private async Task BoldAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("wrapSelection", GetTargetTextarea(), "**", "**", "bold text");
    }

    private async Task ItalicAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("wrapSelection", GetTargetTextarea(), "*", "*", "italic text");
    }

    private async Task BulletListAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("toggleBulletList", GetTargetTextarea());
    }

    private async Task OrderedListAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("toggleOrderedList", GetTargetTextarea());
    }

    private async Task TableAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("insertAtCursor", GetTargetTextarea(), SampleTable);
    }

    private async Task FlowchartLeftToRightAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("insertAtCursor", GetTargetTextarea(), FlowchartLeftToRight);
    }

    private async Task FlowchartTopToBottomAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("insertAtCursor", GetTargetTextarea(), FlowchartTopToBottom);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit's already gone (e.g. tab closed/navigated away) — nothing to clean up.
            }
        }
    }
}
