@inject IAppTimeZoneProvider TimeZoneProvider

<MudPaper Outlined="true" Class="jn-note-item">
    <a class="jn-note-link" href="@($"/notes/{Note.Id}")">
        <div class="jn-note-main">
            <div class="jn-note-title">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled">@(Note.Type == NoteType.Checklist ? "Checklist" : "Text")</MudChip>
                <strong>@(string.IsNullOrWhiteSpace(Note.Title) ? "Untitled note" : Note.Title)</strong>
            </div>
            @if (Note.Tags.Count > 0)
            {
                <div class="jn-tags">
                    @foreach (var tag in Note.Tags)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                    }
                </div>
            }
        </div>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="jn-note-time">@TimeZoneProvider.ToAppTimeZone(Note.UpdatedAt).DateTime.ToString("g")</MudText>
    </a>
</MudPaper>

@code {
    [Parameter, EditorRequired] public NoteSummary Note { get; set; } = null!;
}
