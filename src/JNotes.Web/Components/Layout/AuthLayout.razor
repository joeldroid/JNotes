@inherits LayoutComponentBase

@* Bare layout for /login and /setup — no sidebar nav, since none of those links are reachable
   before you're signed in (or before the first admin even exists).

   These pages render as static SSR (see App.razor), so nothing here or in @Body may be an
   interactive MudBlazor component (they need a circuit). MudThemeProvider is fine: it only emits
   the palette CSS variables, which the plain markup below styles itself with (auth.css).

   /login puts its own, bigger logo inside the card instead (Login.razor), so the header here is
   skipped for it — read from HttpContext rather than a cascading flag from the page, since this
   renders once per request with no circuit for a child->parent update to travel through anyway
   (the same reasoning as App.razor's own path-based render-mode check). *@
<MudThemeProvider Theme="JNotesTheme.Instance" IsDarkMode="true" />

<div class="auth-shell">
    @if (!IsLoginPage)
    {
        <header class="auth-appbar">
            <span class="jn-brand">
                <img src="@Assets["img/jnotes-logo.png"]" alt="" class="jn-brand-logo" />
                JNotes
            </span>
        </header>
    }

    <main class="auth-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private bool IsLoginPage => HttpContext.Request.Path.StartsWithSegments("/login");
}
