@inherits LayoutComponentBase

@* Bare layout for /login and /setup — no sidebar nav, since none of those links are reachable
   before you're signed in (or before the first admin even exists).

   These pages render as static SSR (see App.razor), so nothing here or in @Body may be an
   interactive MudBlazor component (they need a circuit). MudThemeProvider is fine: it only emits
   the palette CSS variables, which the plain markup below styles itself with (auth.css). *@
<MudThemeProvider Theme="JNotesTheme.Instance" IsDarkMode="true" />

<div class="auth-shell">
    <header class="auth-appbar">
        <span class="jn-brand">JNotes</span>
    </header>

    <main class="auth-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
