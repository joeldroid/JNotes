@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISettingsService SettingsService
@inject ICurrentUserContext CurrentUser
@inject ThemeState Theme
@inject IJSRuntime JSRuntime
@inject IBrowserViewportService Viewport
@inject NavigationManager Navigation

<MudThemeProvider Theme="JNotesTheme.Instance" IsDarkMode="Theme.IsDark" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="d-md-none"
                       aria-label="Toggle navigation" OnClick="() => _drawerOpen = !_drawerOpen" />
        <a href="/" class="jn-brand">JNotes</a>
    </MudAppBar>

    @* One responsive drawer instead of the old desktop <aside> + offcanvas pair, so NavMenu (and its
       search box state) exists once. *@
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Always" Elevation="0">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <div class="jn-page">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnInitializedAsync()
    {
        // Guarded on IsAuthenticated: NotFound/Error use this layout with [AllowAnonymous], and
        // ICurrentUserContext.UserId throws for an unauthenticated principal (same rule as NavMenu and
        // App.razor). Dark is the app-wide default, and what an anonymous visitor always gets.
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var isDark = authState.User.Identity?.IsAuthenticated != true
            || await SettingsService.GetThemeAsync(CurrentUser.UserId) == AppTheme.Dark;
        Theme.Initialize(isDark);

        Theme.Changed += OnThemeChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnThemeChanged() => _ = InvokeAsync(async () =>
    {
        StateHasChanged();

        // <html data-theme> is what mermaid-preview.js reads (it can't see MudThemeProvider's state);
        // data-bs-theme keeps not-yet-migrated Bootstrap markup themed until it's removed.
        var name = Theme.IsDark ? AppTheme.Dark : AppTheme.Light;
        try
        {
            await JSRuntime.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", name);
            await JSRuntime.InvokeVoidAsync("document.documentElement.setAttribute", "data-bs-theme", name);
        }
        catch (JSDisconnectedException)
        {
            // The circuit's gone — nothing to update.
        }
    });

    // Below the drawer breakpoint it's an overlay, so picking a destination should dismiss it.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(async () =>
    {
        try
        {
            if (_drawerOpen && await Viewport.GetCurrentBreakpointAsync() is Breakpoint.Xs or Breakpoint.Sm)
            {
                _drawerOpen = false;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    });

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
