@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserRepository UserRepository
@inject ICurrentUserContext CurrentUser
@inject INoteService NoteService
@inject NavigationManager NavigationManager

<div class="d-flex flex-column h-100">
    <AuthorizeView>
        <div class="mb-3">
            <input type="search" class="form-control form-control-sm" placeholder="Search"
                   value="@_searchText" @oninput="OnSearchInput" @onkeydown="OnSearchKeyDown" @onclick="ClearSearch" />
        </div>
    </AuthorizeView>

    <ul class="nav nav-pills flex-column gap-1">
        <AuthorizeView>
            <!-- Same list as Notes/Settings/Trash below (not a separate btn-primary block) so it
                 picks up their nav-link alignment/spacing for free, and Bootstrap's own
                 ".nav-pills .show>.nav-link" rule highlights it only while the type-picker dropdown
                 is actually open — not permanently, the way a standalone colored button would be. -->
            <li class="nav-item dropdown">
                <button class="nav-link dropdown-toggle text-start w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="nav-icon" aria-hidden="true">✎&#xFE0E;</span> New note
                </button>
                <ul class="dropdown-menu">
                    <li><button class="dropdown-item" @onclick='() => CreateNoteAsync(NoteType.Text)'>Text note</button></li>
                    <li><button class="dropdown-item" @onclick='() => CreateNoteAsync(NoteType.Checklist)'>Checklist</button></li>
                </ul>
            </li>
        </AuthorizeView>
        <li class="nav-item">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="nav-icon" aria-hidden="true">▤</span> Notes
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="/settings">
                <span class="nav-icon" aria-hidden="true">⚙&#xFE0E;</span> Settings
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="/trash">
                <span class="nav-icon" aria-hidden="true">♻&#xFE0E;</span> Trash
            </NavLink>
        </li>
    </ul>

    <AuthorizeView>
        <div class="mt-auto pt-3 border-top">
            <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2 w-100 px-0 account-menu-toggle"
                    type="button" data-bs-toggle="collapse" data-bs-target="#accountMenu" aria-expanded="false">
                <span class="account-avatar flex-shrink-0">@_initials</span>
                <span class="text-body text-truncate flex-grow-1 text-start">@_displayName</span>
                <span class="account-menu-chevron text-body-secondary">▸</span>
            </button>
            <div class="collapse" id="accountMenu">
                <ul class="nav nav-pills flex-column gap-1 mt-2">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/profile">
                            My Profile
                        </NavLink>
                    </li>
                </ul>
                <form method="post" action="/logout" class="mt-2">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Sign out</button>
                </form>
            </div>
        </div>
    </AuthorizeView>
</div>

@code {
    private string _displayName = "";
    private string _initials = "";
    private string _searchText = "";

    protected override async Task OnInitializedAsync()
    {
        // Guarded on IsAuthenticated (not just wrapped in <AuthorizeView> in the markup above) —
        // NavMenu renders inside MainLayout, which NotFound/Error also use with [AllowAnonymous],
        // so this can run for a signed-out visitor too. ICurrentUserContext.UserId throws in that
        // case, so it must never be touched outside this check.
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var user = await UserRepository.GetUserByIdAsync(CurrentUser.UserId);
            if (user is not null)
            {
                _displayName = user.FirstName is { Length: > 0 } firstName ? firstName : user.Username;
                _initials = UserInitials.Compute(user.FirstName, user.LastName, user.Username);
            }
        }
    }

    private async Task CreateNoteAsync(NoteType type)
    {
        var defaultBody = type == NoteType.Checklist ? "- [ ] " : "";
        var note = await NoteService.CreateAsync(type, "Untitled note", [], defaultBody);
        NavigationManager.NavigateTo($"/notes/{note.Id}/edit");
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
    }

    private void ClearSearch()
    {
        // Clicking into the box always starts a fresh search rather than requiring the user to
        // manually select-all + delete whatever term they last searched for.
        _searchText = "";
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        // Always lands on / (the notes list) regardless of which page the search was triggered
        // from — NoteList.razor's [SupplyParameterFromQuery] "q" parameter is the only thing that
        // knows how to actually run the search (title/body/tag, via RedisNoteIndexRepository.SearchAsync).
        var trimmed = _searchText.Trim();
        NavigationManager.NavigateTo(trimmed.Length == 0 ? "/" : $"/?q={Uri.EscapeDataString(trimmed)}");
    }
}
