<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item">
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
            Notes
        </NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="/settings">
            Settings
        </NavLink>
    </li>
    <AuthorizeView Roles="Admin">
        <li class="nav-item">
            <NavLink class="nav-link" href="/users">
                User Management
            </NavLink>
        </li>
    </AuthorizeView>
