@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserRepository UserRepository
@inject ICurrentUserContext CurrentUser
@inject INoteService NoteService
@inject NavigationManager NavigationManager

<div class="d-flex flex-column h-100">
    <AuthorizeView>
        <div class="dropdown mb-3">
            <button class="btn btn-primary dropdown-toggle w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                New note
            </button>
            <ul class="dropdown-menu">
                <li><button class="dropdown-item" @onclick='() => CreateNoteAsync(NoteType.Text)'>Text note</button></li>
                <li><button class="dropdown-item" @onclick='() => CreateNoteAsync(NoteType.Checklist)'>Checklist</button></li>
            </ul>
        </div>
    </AuthorizeView>

    <ul class="nav nav-pills flex-column gap-1">
        <li class="nav-item">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                Notes
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="/settings">
                Settings
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="/trash">
                Trash
            </NavLink>
        </li>
    </ul>

    <AuthorizeView>
        <div class="mt-auto pt-3 border-top">
            <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2 w-100 px-0 account-menu-toggle"
                    type="button" data-bs-toggle="collapse" data-bs-target="#accountMenu" aria-expanded="false">
                <span class="account-avatar flex-shrink-0">@_initials</span>
                <span class="text-body text-truncate flex-grow-1 text-start">@_displayName</span>
                <span class="account-menu-chevron text-body-secondary">▸</span>
            </button>
            <div class="collapse" id="accountMenu">
                <ul class="nav nav-pills flex-column gap-1 mt-2">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/profile">
                            My Profile
                        </NavLink>
                    </li>
                </ul>
                <form method="post" action="/logout" class="mt-2">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Sign out</button>
                </form>
            </div>
        </div>
    </AuthorizeView>
</div>

@code {
    private string _displayName = "";
    private string _initials = "";

    protected override async Task OnInitializedAsync()
    {
        // Guarded on IsAuthenticated (not just wrapped in <AuthorizeView> in the markup above) —
        // NavMenu renders inside MainLayout, which NotFound/Error also use with [AllowAnonymous],
        // so this can run for a signed-out visitor too. ICurrentUserContext.UserId throws in that
        // case, so it must never be touched outside this check.
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var user = await UserRepository.GetUserByIdAsync(CurrentUser.UserId);
            if (user is not null)
            {
                _displayName = user.FirstName is { Length: > 0 } firstName ? firstName : user.Username;
                _initials = UserInitials.Compute(user.FirstName, user.LastName, user.Username);
            }
        }
    }

    private async Task CreateNoteAsync(NoteType type)
    {
        var defaultBody = type == NoteType.Checklist ? "- [ ] " : "";
        var note = await NoteService.CreateAsync(type, "Untitled note", [], defaultBody);
        NavigationManager.NavigateTo($"/notes/{note.Id}");
    }
}
