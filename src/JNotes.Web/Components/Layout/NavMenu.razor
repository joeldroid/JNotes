@implements IAsyncDisposable
@inject IUserRepository UserRepository
@inject ICurrentUserContext CurrentUser
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item">
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
            Notes
        </NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="/settings">
            Settings
        </NavLink>
    </li>
</ul>

<div class="mt-3 pt-3 border-top">
    <label for="actAsSelect" class="small text-body-secondary mb-1 d-block">Acting as (dev only, not secure)</label>
    <select id="actAsSelect" class="form-select form-select-sm" @onchange="OnUserSelectedAsync">
        @foreach (var user in _users)
        {
            <option value="@user.Id" selected="@(user.Id == CurrentUser.UserId)">@user.Username</option>
        }
    </select>
</div>

@code {
    private IReadOnlyList<UserAccount> _users = [];
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        _users = await UserRepository.GetAllUsersAsync();
    }

    private async Task OnUserSelectedAsync(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var userId))
        {
            return;
        }

        _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/act-as-cookie.js");
        await _module.InvokeVoidAsync("setActAsUser", userId);

        // ICurrentUserContext is captured once per circuit (see its doc comment) — only a real new
        // HTTP request (a new circuit) picks up the changed cookie, so this must be a forced full
        // navigation, not a client-side route change.
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit's already gone (e.g. tab closed/navigated away) — nothing to clean up.
            }
        }
    }
}
