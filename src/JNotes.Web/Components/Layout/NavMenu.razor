@implements IDisposable
@inject NavigationManager NavigationManager

<div class="jn-nav">
    <AuthorizeView>
        <div class="jn-nav-search">
            @* Clicking anywhere in the field starts a fresh search (see ClearSearch); the unmatched @onclick
               lands on MudTextField's root element, so it also fires for clicks on the input itself. *@
            <MudTextField T="string" Value="_searchText" ValueChanged="OnSearchChanged" Immediate="true"
                          Placeholder="Search" aria-label="Search notes" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="OnSearchKeyDown" @onclick="ClearSearch" />
        </div>
    </AuthorizeView>

    <MudNavMenu Class="jn-nav-list">
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.StickyNote2">All Notes</MudNavLink>
        @* One entry per note type (rather than a "New note" dropdown): each opens the editor on an unsaved
           draft (nothing is created until Save). Wrapped in an unqualified <AuthorizeView> because NavMenu
           also renders for NotFound/Error; the dividers live inside it so an anonymous visitor doesn't get
           two separators around nothing.
           These deliberately have no Href (so MudNavLink raises OnClick instead of navigating as a NavLink -
           see the CLAUDE.md note on this), which means MudBlazor's own route-matching "active" highlight
           never applies to them. IsNewNoteRouteActive/jn-nav-active (nav-menu.css) reproduce it manually so
           these two links highlight like every Href-based one when their draft route is open. *@
        <AuthorizeView>
            <MudDivider Class="my-2" />
            <MudNavLink Icon="@Icons.Material.Outlined.NoteAdd" Class="@(IsNewNoteRouteActive(NoteType.Text) ? "jn-nav-active" : null)"
                        OnClick="() => NewNote(NoteType.Text)">New Text Note</MudNavLink>
            <MudNavLink Icon="@Icons.Material.Outlined.Checklist" Class="@(IsNewNoteRouteActive(NoteType.Checklist) ? "jn-nav-active" : null)"
                        OnClick="() => NewNote(NoteType.Checklist)">New Checklist Note</MudNavLink>
            <MudDivider Class="my-2" />
        </AuthorizeView>
        <MudNavLink Href="/trash" Icon="@Icons.Material.Outlined.DeleteOutline">Trash</MudNavLink>
    </MudNavMenu>

    @* Must stay the last child of div.jn-nav: .jn-account { margin-top: auto } bottom-anchors it (below md
       only - at md and up the same widget lives in MainLayout's app bar and this copy is d-md-none). *@
    <AccountMenu DisplayName="@DisplayName" Initials="@Initials" />
</div>

@code {
    [Parameter]
    public string DisplayName { get; set; } = "";

    [Parameter]
    public string Initials { get; set; } = "";

    private string _searchText = "";

    protected override void OnInitialized()
    {
        // MainLayout (and NavMenu inside it) survives client-side navigation on this circuit, so this
        // runs once per circuit, not once per page - LocationChanged is what keeps IsNewNoteRouteActive
        // (and therefore the "New Text Note"/"New Checklist Note" highlight) current after that.
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;

    // Only navigates: NoteEditor's /notes/new/{type} route holds the note as an in-memory draft and
    // creates it when the user clicks Save.
    private void NewNote(NoteType type) =>
        NavigationManager.NavigateTo($"/notes/new/{type.ToString().ToLowerInvariant()}");

    // Mirrors the route NewNote navigates to, so the link highlights while that draft is open - see
    // the markup comment above on why MudNavLink can't do this itself for an OnClick-only link.
    private bool IsNewNoteRouteActive(NoteType type)
    {
        var path = new Uri(NavigationManager.Uri).AbsolutePath.Trim('/');
        return string.Equals(path, $"notes/new/{type.ToString().ToLowerInvariant()}", StringComparison.OrdinalIgnoreCase);
    }

    private void OnSearchChanged(string? value) => _searchText = value ?? "";

    private void ClearSearch()
    {
        // Clicking into the box always starts a fresh search rather than requiring the user to
        // manually select-all + delete whatever term they last searched for.
        _searchText = "";
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        // Always lands on / (the notes list) regardless of which page the search was triggered
        // from — NoteList.razor's [SupplyParameterFromQuery] "q" parameter is the only thing that
        // knows how to actually run the search (title/body/tag, via PostgresNoteIndexRepository.SearchAsync).
        var trimmed = _searchText.Trim();
        NavigationManager.NavigateTo(trimmed.Length == 0 ? "/" : $"/?q={Uri.EscapeDataString(trimmed)}");
    }
}
