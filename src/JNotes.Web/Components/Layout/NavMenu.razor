@inject NavigationManager NavigationManager

<div class="jn-nav">
    <AuthorizeView Context="auth">
        <div class="jn-nav-search">
            @* Clicking anywhere in the field starts a fresh search (see ClearSearch); the unmatched @onclick
               lands on MudTextField's root element, so it also fires for clicks on the input itself. *@
            <MudTextField T="string" Value="_searchText" ValueChanged="OnSearchChanged" Immediate="true"
                          Placeholder="Search" aria-label="Search notes" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="OnSearchKeyDown" @onclick="ClearSearch" />
        </div>
        @* "New Note": a plain link to the /notes/new draft (nothing is created until Save - NoteEditor holds an
           in-memory draft). Sits OUTSIDE MudNavMenu so it can be styled as a filled primary button (nav-menu.css).
           It stays in this shared AuthorizeView because NavMenu also renders for anonymous NotFound/Error. *@
        <div class="jn-nav-new">
            <MudButton Href="/notes/new" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Add">New Note</MudButton>
        </div>
    </AuthorizeView>

    <MudNavMenu Class="jn-nav-list" aria-label="Main navigation">
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.StickyNote2">All Notes</MudNavLink>
        <MudNavLink Href="/shared" Icon="@Icons.Material.Outlined.People">Shared with Me</MudNavLink>
    </MudNavMenu>

    @* Signed-in only: NavMenu also renders for NotFound/Error ([AllowAnonymous]). MainLayout never loads the
       list for an anonymous user either; this is the markup half. *@
    <AuthorizeView Context="auth">
        <RecentNotes Notes="RecentNotes" />
    </AuthorizeView>

    @* Trash sits at the bottom of the sidebar: .jn-nav-trash { margin-top: auto } bottom-anchors it, and
       below md the account section follows directly beneath it. *@
    <MudNavMenu Class="jn-nav-trash" aria-label="Trash">
        <MudDivider Class="my-2" />
        <MudNavLink Href="/trash" Icon="@Icons.Material.Outlined.DeleteOutline">Trash</MudNavLink>
    </MudNavMenu>

    @* Must stay the last child of div.jn-nav, directly after the Trash menu (below md only - at md and up the
       same widget lives in MainLayout's app bar and this copy is d-md-none). *@
    <AccountMenu DisplayName="@DisplayName" Initials="@Initials" />
</div>

@code {
    [Parameter]
    public string DisplayName { get; set; } = "";

    [Parameter]
    public string Initials { get; set; } = "";

    [Parameter]
    public IReadOnlyList<NoteSummary>? RecentNotes { get; set; }

    private string _searchText = "";

    private void OnSearchChanged(string? value) => _searchText = value ?? "";

    private void ClearSearch()
    {
        // Clicking into the box always starts a fresh search rather than requiring the user to
        // manually select-all + delete whatever term they last searched for.
        _searchText = "";
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        // Always lands on / (the notes list) regardless of which page the search was triggered
        // from — NoteList.razor's [SupplyParameterFromQuery] "q" parameter is the only thing that
        // knows how to actually run the search (title/body/tag, via PostgresNoteIndexRepository.SearchAsync).
        var trimmed = _searchText.Trim();
        NavigationManager.NavigateTo(trimmed.Length == 0 ? "/" : $"/?q={Uri.EscapeDataString(trimmed)}");
    }
}
