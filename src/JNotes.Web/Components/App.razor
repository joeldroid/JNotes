<!DOCTYPE html>
@* data-theme is fixed to "dark" because mermaid-preview.js reads it, and there is no user theme. *@
<html lang="en" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["JNotes.Web.styles.css"]" />
    <link rel="icon" type="image/x-icon" href="@Assets["favicon.ico"]" />
    <link rel="icon" type="image/png" sizes="32x32" href="@Assets["img/favicon-32x32.png"]" />
    <link rel="icon" type="image/png" sizes="16x16" href="@Assets["img/favicon-16x16.png"]" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Assets["img/apple-touch-icon.png"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <ReconnectModal />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // /login and /setup handle a plain form POST that must call HttpContext.SignInAsync — that
    // only works while the response is still being built, which is true for a statically-rendered
    // page but not from inside an already-connected InteractiveServer circuit (headers long sent).
    // HttpContext is available here as a cascading parameter because App.razor renders as part of
    // the initial HTTP response, before any circuit exists.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/login") || HttpContext.Request.Path.StartsWithSegments("/setup")
            ? null // static SSR
            : InteractiveServer;
}
