@inject ISettingsService SettingsService
@inject ICurrentUserContext CurrentUser

<!DOCTYPE html>
<html lang="en" data-theme="@_theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["JNotes.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <ReconnectModal />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string _theme = AppTheme.Dark;

    // /login and /setup handle a plain form POST that must call HttpContext.SignInAsync — that
    // only works while the response is still being built, which is true for a statically-rendered
    // page but not from inside an already-connected InteractiveServer circuit (headers long sent).
    // HttpContext is available here as a cascading parameter because App.razor renders as part of
    // the initial HTTP response, before any circuit exists.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/login") || HttpContext.Request.Path.StartsWithSegments("/setup")
            ? null // static SSR
            : InteractiveServer;

    protected override async Task OnInitializedAsync()
    {
        // Read during prerender so the initial HTML already has the right data-theme — avoids a
        // flash of the wrong theme before the circuit connects. Guarded: on /login, /setup, or any
        // request before anyone's authenticated, ICurrentUserContext would throw — default to dark
        // (this app's app-wide default, see SettingsService.GetThemeAsync) rather than making
        // ICurrentUserContext.UserId nullable (which would ripple into every Core call site that
        // assumes a valid Guid).
        _theme = HttpContext.User.Identity?.IsAuthenticated == true
            ? await SettingsService.GetThemeAsync(CurrentUser.UserId)
            : AppTheme.Dark;
    }
}
