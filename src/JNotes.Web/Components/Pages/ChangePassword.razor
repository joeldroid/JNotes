@page "/settings/change-password"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject IUserRepository UserRepository
@inject ICurrentUserContext CurrentUser
@inject NavigationManager NavigationManager

<PageTitle>Change Password</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">Change Password</MudText>

@if (_user is null)
{
    <MudText Color="Color.Secondary">Loading…</MudText>
}
else
{
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="jn-form-narrow">
        <DataAnnotationsValidator />
        <MudStack Spacing="2">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

            @if (_hasPassword)
            {
                <MudTextField T="string" @bind-Value="_model.CurrentPassword" Label="Current password" InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            }

            <MudTextField T="string" @bind-Value="_model.NewPassword" Label="New password" InputType="@_newPasswordInputType"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End"
                          AdornmentIcon="@_newPasswordAdornmentIcon" AdornmentAriaLabel="@(_showNewPassword ? "Hide password" : "Show password")"
                          OnAdornmentClick="() => _showNewPassword = !_showNewPassword" />

            <MudTextField T="string" @bind-Value="_model.ConfirmNewPassword" Label="Confirm new password" InputType="@_newPasswordInputType"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />

            <MudStack Row="true" Spacing="2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" Disabled="_isSaving">
                    @(_isSaving ? "Saving…" : "Change password")
                </MudButton>
                <MudButton Variant="Variant.Text" Href="/settings">Cancel</MudButton>
            </MudStack>
        </MudStack>
    </EditForm>
}

@code {
    private UserAccount? _user;
    private bool _hasPassword;
    private PasswordModel _model = new();
    private bool _isSaving;
    private string? _error;

    // One toggle for both new-password fields — masked by default; the icon lives on "New
    // password" only, since Confirm exists just to catch a typo against whatever New shows.
    private bool _showNewPassword;
    private InputType _newPasswordInputType => _showNewPassword ? InputType.Text : InputType.Password;
    private string _newPasswordAdornmentIcon => _showNewPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    protected override async Task OnInitializedAsync()
    {
        _user = await UserRepository.GetUserByIdAsync(CurrentUser.UserId);
        _hasPassword = _user?.PasswordHash is not null;
    }

    private async Task SubmitAsync()
    {
        _error = null;

        if (_model.NewPassword.Length < 8)
        {
            _error = "New password must be at least 8 characters.";
            return;
        }

        if (_model.NewPassword != _model.ConfirmNewPassword)
        {
            _error = "New passwords don't match.";
            return;
        }

        // An OIDC-only account has no current password to check — this is then "set a password"
        // rather than "change" one, same as the admin's own reset-password flow.
        if (_hasPassword)
        {
            var verified = await UserRepository.VerifyPasswordAsync(_user!.Username, _model.CurrentPassword);
            if (verified is null)
            {
                _error = "Current password is incorrect.";
                return;
            }
        }

        _isSaving = true;
        try
        {
            await UserRepository.SetPasswordAsync(CurrentUser.UserId, _model.NewPassword);
            NavigationManager.NavigateTo("/settings");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private sealed class PasswordModel
    {
        public string CurrentPassword { get; set; } = "";

        [Required]
        public string NewPassword { get; set; } = "";

        [Required]
        public string ConfirmNewPassword { get; set; } = "";
    }
}
