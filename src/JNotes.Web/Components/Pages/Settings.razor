@page "/settings"
@attribute [Authorize]
@using Microsoft.Extensions.Options
@inject ISettingsService SettingsService
@inject INoteIndexReconciler Reconciler
@inject INoteService NoteService
@inject IUserRepository UserRepository
@inject ICurrentUserContext CurrentUser
@inject IOptions<OidcOptions> OidcOptionsAccessor
@inject IJSRuntime JSRuntime

<PageTitle>Settings</PageTitle>

<h1 class="h3 mb-3">Settings</h1>

<section class="mb-4">
    <h2 class="h5">Appearance</h2>
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="darkModeSwitch"
               checked="@(_theme == AppTheme.Dark)" @onchange="ToggleThemeAsync" />
        <label class="form-check-label" for="darkModeSwitch">Dark mode</label>
    </div>
</section>

<section class="mb-4">
    <h2 class="h5">Storage</h2>
    <p class="mb-1"><strong>Notes folder:</strong> <code>@_notesFolderPath</code></p>
    <p class="text-body-secondary small">Changing the notes folder requires an app restart to take effect.</p>
    <p class="mb-0"><strong>Notes indexed:</strong> @_noteCount</p>
</section>

<section class="mb-4">
    <h2 class="h5">Index</h2>
    <p class="text-body-secondary small">
        The index is rebuilt automatically at startup. Use this if you've added, edited, or removed
        note files directly on disk while the app is running.
    </p>
    <button class="btn btn-outline-primary" @onclick="RescanAsync" disabled="@_isRescanning">
        @(_isRescanning ? "Rescanning…" : "Rescan Now")
    </button>

    @if (_lastResult is { } result)
    {
        <div class="alert @(result.Errors.Count > 0 ? "alert-warning" : "alert-success") mt-3 mb-0">
            <div>Added @result.Added, updated @result.Updated, removed @result.Removed.</div>
            @if (result.Errors.Count > 0)
            {
                <ul class="mb-0 mt-2">
                    @foreach (var error in result.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        </div>
    }
</section>

<section class="mb-4" style="max-width: 420px;">
    <h2 class="h5">Account</h2>
    <div class="d-flex gap-2 align-items-end flex-wrap">
        <div class="flex-grow-1">
            <label class="form-label small mb-1">New password</label>
            <input type="password" class="form-control" @bind="_newPassword" @bind:event="oninput" />
        </div>
        <button class="btn btn-outline-primary" @onclick="ChangePasswordAsync">Change password</button>
    </div>
    @if (_passwordChangeMessage is not null)
    {
        <div class="alert @(_passwordChangeError ? "alert-danger" : "alert-success") py-2 mt-2 mb-0">@_passwordChangeMessage</div>
    }
</section>

<AuthorizeView Roles="Admin">
    <section>
        <h2 class="h5">Security</h2>
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" role="switch" id="passwordAuthSwitch"
                   checked="@_passwordAuthEnabled" disabled="@(!_oidc.IsConfigured && _passwordAuthEnabled)"
                   @onchange="TogglePasswordAuthAsync" />
            <label class="form-check-label" for="passwordAuthSwitch">Allow username/password login</label>
        </div>
        @if (!_oidc.IsConfigured)
        {
            <p class="text-body-secondary small">
                Can't be turned off — OIDC isn't configured (set OIDC_AUTHORITY/OIDC_CLIENT_ID/OIDC_CLIENT_SECRET), so this is the only sign-in method available.
            </p>
        }
        else
        {
            <p class="text-body-secondary small">OIDC is configured against <code>@_oidc.Authority</code>.</p>
        }
        @if (_securityError is not null)
        {
            <div class="alert alert-danger py-2">@_securityError</div>
        }
    </section>
</AuthorizeView>

@code {
    private string _theme = AppTheme.Light;
    private string _notesFolderPath = "";
    private int _noteCount;
    private bool _isRescanning;
    private ReconciliationResult? _lastResult;

    private string _newPassword = "";
    private string? _passwordChangeMessage;
    private bool _passwordChangeError;

    private bool _passwordAuthEnabled;
    private OidcOptions _oidc = new();
    private string? _securityError;

    protected override async Task OnInitializedAsync()
    {
        _theme = await SettingsService.GetThemeAsync(CurrentUser.UserId);
        _notesFolderPath = await SettingsService.GetNotesFolderPathAsync();
        await RefreshCountAsync();

        _oidc = OidcOptionsAccessor.Value;
        _passwordAuthEnabled = await SettingsService.GetPasswordAuthEnabledAsync();
    }

    private async Task ToggleThemeAsync(ChangeEventArgs e)
    {
        _theme = e.Value is true ? AppTheme.Dark : AppTheme.Light;
        await SettingsService.SetThemeAsync(CurrentUser.UserId, _theme);

        // Applies instantly without a reload — the <html> element persists across in-app
        // navigation under InteractiveServer, so this sticks until a real page reload, at which
        // point App.razor reads the now-persisted setting server-side anyway.
        await JSRuntime.InvokeVoidAsync("document.documentElement.setAttribute", "data-bs-theme", _theme);
    }

    private async Task RefreshCountAsync()
    {
        var notes = await NoteService.ListAsync(new NoteSearchQuery());
        _noteCount = notes.Count;
    }

    private async Task RescanAsync()
    {
        _isRescanning = true;
        _lastResult = await Reconciler.RescanAsync(CurrentUser.UserId);
        await RefreshCountAsync();
        _isRescanning = false;
    }

    private async Task ChangePasswordAsync()
    {
        if (_newPassword.Length < 8)
        {
            _passwordChangeError = true;
            _passwordChangeMessage = "Password must be at least 8 characters.";
            return;
        }

        await UserRepository.SetPasswordAsync(CurrentUser.UserId, _newPassword);
        _newPassword = "";
        _passwordChangeError = false;
        _passwordChangeMessage = "Password changed.";
    }

    private async Task TogglePasswordAuthAsync(ChangeEventArgs e)
    {
        var enabled = e.Value is true;
        _securityError = null;
        try
        {
            await SettingsService.SetPasswordAuthEnabledAsync(enabled);
            _passwordAuthEnabled = enabled;
        }
        catch (InvalidOperationException ex)
        {
            _securityError = ex.Message;
        }
    }
}
