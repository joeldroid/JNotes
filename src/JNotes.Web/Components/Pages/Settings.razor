@page "/settings"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using JNotes.Core
@using JNotes.Web.Tagging
@using Microsoft.Extensions.Options
@inject ISettingsService SettingsService
@inject INoteIndexReconciler Reconciler
@inject INoteService NoteService
@inject IImageCleanupService ImageCleanup
@inject IAppTimeZoneProvider TimeZoneProvider
@inject IUserRepository UserRepository
@inject IUserManagementService UserManagementService
@inject ICurrentUserContext CurrentUser
@inject IOptions<OidcOptions> OidcOptionsAccessor
@inject IOptions<JNotesOptions> JNotesOptionsAccessor
@inject IOptions<AutoTagOptions> AutoTagOptionsAccessor
@inject AutoTagStatus AutoTagStatus
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Settings</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">Settings</MudText>

<section class="jn-settings-group">
    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">App settings</MudText>

    <MudPaper Outlined="true" Class="jn-settings-card jn-settings-card-narrow">
        <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mb-2">Account</MudText>

        @if (_profileError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_profileError</MudAlert>
        }

        <MudText Class="mb-2">
            <strong>Username:</strong> @_currentUserAccount?.Username
            <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">(username can't be changed here)</MudText>
        </MudText>

        <MudStack Spacing="2" Class="mb-3">
            <MudTextField T="string" @bind-Value="_profileFirstName" Immediate="true" Label="First name" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_profileLastName" Immediate="true" Label="Last name" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_profileEmail" Immediate="true" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Disabled="@(!_canEditEmail)"
                          HelperText="@(_canEditEmail ? null : "Only an admin can change your email.")" />
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveProfileAsync" Disabled="_isSavingProfile">
                    @(_isSavingProfile ? "Saving…" : "Save profile")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Href="/settings/change-password">Change password</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
</section>

<AuthorizeView Roles="Admin" Context="adminAuthContext">
    <section class="jn-settings-group">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Administration settings</MudText>

        <MudPaper Outlined="true" Class="jn-settings-card">
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mb-1">Security</MudText>
            @* @key is bumped when the server refuses a change, so the switch is rebuilt from the model instead of
               keeping the position the user just clicked it to. *@
            <MudSwitch @key="_securityVersion" T="bool" Value="_passwordAuthEnabled" ValueChanged="TogglePasswordAuthAsync"
                       Disabled="@(!_oidc.IsConfigured && _passwordAuthEnabled)" Color="Color.Primary"
                       Label="Allow username/password login" />
            @if (!_oidc.IsConfigured)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Can't be turned off — OIDC isn't configured (set OIDC_AUTHORITY/OIDC_CLIENT_ID/OIDC_CLIENT_SECRET), so this is the only sign-in method available.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">OIDC is configured against <code class="jn-code">@_oidc.Authority</code>.</MudText>
            }
            @if (_securityError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_securityError</MudAlert>
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="jn-settings-card">
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mb-1">Storage</MudText>
            <MudText Class="mb-1"><strong>Notes folder:</strong> <code class="jn-code">@_notesFolderPath</code></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Changing the notes folder requires an app restart to take effect.</MudText>
            <MudText><strong>Notes indexed:</strong> @_noteCount</MudText>
        </MudPaper>

        <MudPaper Outlined="true" Class="jn-settings-card">
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mb-1">Index</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                The index is rebuilt automatically at startup@(JNotesOptionsAccessor.Value.AutoIndexIntervalMinutes > 0 ? $" and every {JNotesOptionsAccessor.Value.AutoIndexIntervalMinutes} minute(s)" : ""). Use this if you've added, edited, or removed
                note files directly on disk while the app is running.
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RescanAsync" Disabled="_isRescanning">
                @(_isRescanning ? "Rescanning…" : "Rescan Now")
            </MudButton>

            @if (_lastResult is { } result)
            {
                <MudAlert Severity="@(result.Errors.Count > 0 ? Severity.Warning : Severity.Success)" Class="mt-3">
                    <div>Added @result.Added, updated @result.Updated, removed @result.Removed.</div>
                    @if (result.Errors.Count > 0)
                    {
                        <ul class="jn-alert-list">
                            @foreach (var error in result.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </MudAlert>
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="jn-settings-card">
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mb-1">Images</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                Deleting a note (even permanently) never deletes the images pasted into it, because the same
                image can be used by several notes. Instead, images that no note or trashed note uses any more
                are removed for <strong>all users</strong> on a schedule. Images added in the last
                @((int)ImageCleanupSchedule.MinImageAge.TotalMinutes) minutes are always kept.
            </MudText>

            <div class="jn-inline-form jn-inline-form-center mb-1">
                <span>Clean up every</span>
                <MudNumericField T="int" @bind-Value="_imageCleanupDays" Immediate="true" aria-label="Days between image cleanups"
                                 Min="ImageCleanupSchedule.DisabledIntervalDays" Max="ImageCleanupSchedule.MaxIntervalDays"
                                 HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="jn-days-field" />
                <span>day(s)</span>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveImageCleanupIntervalAsync">Save</MudButton>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                Enter 0 to turn the automatic cleanup off (@ImageCleanupSchedule.MaxIntervalDays days at most). Default: @ImageCleanupSchedule.DefaultIntervalDays.
            </MudText>
            @if (_imageCleanupSettingMessage is not null)
            {
                <MudAlert Severity="@(_imageCleanupSettingError ? Severity.Error : Severity.Success)" Dense="true" Class="mb-2">@_imageCleanupSettingMessage</MudAlert>
            }

            <MudText Class="mb-2">
                <strong>Last cleanup:</strong>
                @(_imageCleanupLastRun is { } lastRun
                    ? TimeZoneProvider.ToAppTimeZone(lastRun).ToString("f")
                    : "not yet")
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CleanUpImagesAsync" Disabled="_isCleaningImages">
                @(_isCleaningImages ? "Cleaning up…" : "Clean up now")
            </MudButton>

            @if (_imageCleanupError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_imageCleanupError</MudAlert>
            }
            else if (_imageCleanupResult is { } cleanup)
            {
                <MudAlert Severity="@(cleanup.UsersFailed > 0 ? Severity.Warning : Severity.Success)" Class="mt-3">
                    <div>
                        @(cleanup.Deleted == 0
                            ? "No unused images found."
                            : $"Removed {cleanup.Deleted} unused image{(cleanup.Deleted == 1 ? "" : "s")}, freeing {FormatBytes(cleanup.BytesFreed)}.")
                    </div>
                    @if (cleanup.SkippedRecent > 0)
                    {
                        <div class="jn-alert-detail">
                            @cleanup.SkippedRecent recent image@(cleanup.SkippedRecent == 1 ? " was" : "s were") kept for now — run this again in a few minutes.
                        </div>
                    }
                    @if (cleanup.UsersFailed > 0)
                    {
                        <div class="jn-alert-detail">Cleanup failed for @cleanup.UsersFailed user(s) — see the server log.</div>
                    }
                </MudAlert>
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="jn-settings-card">
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mb-1">Auto-tagging</MudText>
            @if (!AutoTagOptionsAccessor.Value.IsEnabled)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Off. Set OLLAMA_URL to tag untagged notes automatically with a local Ollama model.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Every @AutoTagOptionsAccessor.Value.IntervalMinutes minute(s), up to @AutoTagOptionsAccessor.Value.BatchSize untagged
                    note(s) per pass are sent to the Ollama model <code class="jn-code">@AutoTagOptionsAccessor.Value.Model</code> and tagged.
                    Notes changed in the last @((int)AutoTagSchedule.MinNoteAge.TotalMinutes) minutes wait. Tags you've written are never
                    changed, and each note is tried once.
                </MudText>
                <MudText Class="mb-1">
                    <strong>Last pass:</strong>
                    @(_autoTagStatus.IsRunning
                        ? "running now"
                        : _autoTagStatus.LastPassFinishedUtc is { } lastPass
                            ? $"{TimeZoneProvider.ToAppTimeZone(lastPass):f}, {_autoTagStatus.LastPassTagged} tagged"
                            : "not yet")
                </MudText>
                <MudText Class="mb-1"><strong>Tagged since startup:</strong> @_autoTagStatus.TaggedSinceStartup</MudText>
                @if (_autoTagStatus.UnavailableReason is { } unavailableReason)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        Ollama unavailable@(_autoTagStatus.UnavailableSinceUtc is { } since ? $" since {TimeZoneProvider.ToAppTimeZone(since):f}" : ""): @unavailableReason
                    </MudAlert>
                }
            }
        </MudPaper>

        <MudPaper Outlined="true" Class="jn-settings-card jn-settings-card-wide">
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mb-2">User management</MudText>

            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Auth methods</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in _users)
                    {
                        var isSelf = user.Id == CurrentUser.UserId;
                        var isLastAdmin = user.Role == UserRole.Admin && _adminCount <= 1;
                        var name = string.Join(" ", new[] { user.FirstName, user.LastName }.Where(n => !string.IsNullOrWhiteSpace(n)));

                        <tr>
                            <td>@user.Username @(isSelf ? "(you)" : "")</td>
                            <td>@(name.Length > 0 ? name : "—")</td>
                            <td>@user.Role</td>
                            <td>@(user.Email ?? "—")</td>
                            <td>
                                @(user.PasswordHash is not null ? "Password" : "")
                                @(user.PasswordHash is not null && user.OidcSubject is not null ? " + " : "")
                                @(user.OidcSubject is not null ? "OIDC" : "")
                            </td>
                            <td>@user.CreatedAt.LocalDateTime.ToString("d")</td>
                            <td>
                                <div class="jn-row-actions">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => BeginEditProfile(user)">Edit profile</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => BeginResetPassword(user)">Reset password</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="@(isSelf || isLastAdmin)"
                                               OnClick="() => BeginDelete(user)">Delete</MudButton>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <div class="jn-form-narrow">
                <MudText Typo="Typo.subtitle2" HtmlTag="h4" Class="mb-2">Add user</MudText>
                <EditForm Model="_newUser" OnValidSubmit="CreateUserAsync">
                    <DataAnnotationsValidator />
                    <MudStack Spacing="2">
                        @if (_createUserError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">@_createUserError</MudAlert>
                        }
                        <MudTextField @bind-Value="_newUser.Username" For="() => _newUser.Username" Label="Username (Lowercase only)"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudSelect T="UserRole" @bind-Value="_newUser.Role" Label="Role" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="UserRole" Value="UserRole.Member">Member</MudSelectItem>
                            <MudSelectItem T="UserRole" Value="UserRole.Admin">Admin</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="_newUser.Email" Label="Email" HelperText="Needed to link an OIDC sign-in later."
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="_newUser.Password" Label="Password" InputType="InputType.Password"
                                      HelperText="Leave blank for an OIDC-only account." Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <div>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" Disabled="_isCreating">Add user</MudButton>
                        </div>
                    </MudStack>
                </EditForm>
            </div>
        </MudPaper>
    </section>

    @* The user dialogs live inside the Administration AuthorizeView (they used to sit after it, gated only by
       the state the admin-rendered buttons set) so a Member's circuit never gets any of their handler ids. *@
    <MudDialog Visible="@(_editProfileTarget is not null)" VisibleChanged="OnEditProfileVisibleChanged" Options="_dialogOptions">
        <TitleContent>Edit profile for @_editProfileTarget?.Username</TitleContent>
        <DialogContent>
            <MudStack Spacing="2">
                @if (_editProfileError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_editProfileError</MudAlert>
                }
                <MudTextField T="string" @bind-Value="_editFirstName" Immediate="true" Label="First name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" @bind-Value="_editLastName" Immediate="true" Label="Last name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" @bind-Value="_editEmail" Immediate="true" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _editProfileTarget = null">Cancel</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ConfirmEditProfileAsync">Save</MudButton>
        </DialogActions>
    </MudDialog>

    <MudDialog Visible="@(_resetPasswordTarget is not null)" VisibleChanged="OnResetPasswordVisibleChanged" Options="_dialogOptions">
        <TitleContent>Reset password for @_resetPasswordTarget?.Username</TitleContent>
        <DialogContent>
            <MudStack Spacing="2">
                @if (_resetPasswordError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_resetPasswordError</MudAlert>
                }
                <MudTextField T="string" @bind-Value="_resetPasswordValue" Immediate="true" Label="New password" InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _resetPasswordTarget = null">Cancel</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ConfirmResetPasswordAsync">Set password</MudButton>
        </DialogActions>
    </MudDialog>

    <MudDialog Visible="@(_deleteTarget is not null)" VisibleChanged="OnDeleteVisibleChanged" Options="_dialogOptions">
        <TitleContent>Delete @_deleteTarget?.Username?</TitleContent>
        <DialogContent>
            <MudStack Spacing="2">
                <MudText>
                    Their notes won't be deleted — the folder is moved aside
                    (<code class="jn-code">notes/deleted/@_deleteTarget?.Id/</code>) and their account is removed.
                </MudText>
                @if (_deleteError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_deleteError</MudAlert>
                }
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _deleteTarget = null">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteAsync">Delete</MudButton>
        </DialogActions>
    </MudDialog>
</AuthorizeView>

@code {
    // App settings
    private UserAccount? _currentUserAccount;
    private string _profileFirstName = "";
    private string _profileLastName = "";
    private string _profileEmail = "";
    private bool _canEditEmail;
    private bool _isSavingProfile;
    private string? _profileError;

    // Administration settings
    private string _notesFolderPath = "";
    private int _noteCount;
    private bool _isRescanning;
    private ReconciliationResult? _lastResult;

    private int _imageCleanupDays;
    private DateTimeOffset? _imageCleanupLastRun;
    private string? _imageCleanupSettingMessage;
    private bool _imageCleanupSettingError;
    private bool _isCleaningImages;
    private AllUsersImageCleanupResult? _imageCleanupResult;
    private string? _imageCleanupError;

    // A snapshot taken at page load (admins only): the card doesn't update live.
    private AutoTagStatusSnapshot _autoTagStatus = new(false, null, 0, 0, null, null);

    private bool _passwordAuthEnabled;
    private OidcOptions _oidc = new();
    private string? _securityError;
    private int _securityVersion;

    private static readonly DialogOptions _dialogOptions = new()
    {
        CloseOnEscapeKey = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Small,
    };

    private IReadOnlyList<UserAccount> _users = [];
    private int _adminCount;

    private NewUserModel _newUser = new();
    private bool _isCreating;
    private string? _createUserError;

    private UserAccount? _editProfileTarget;
    private string _editFirstName = "";
    private string _editLastName = "";
    private string _editEmail = "";
    private string? _editProfileError;

    private UserAccount? _resetPasswordTarget;
    private string _resetPasswordValue = "";
    private string? _resetPasswordError;

    private UserAccount? _deleteTarget;
    private string? _deleteError;

    protected override async Task OnInitializedAsync()
    {
        _currentUserAccount = await UserRepository.GetUserByIdAsync(CurrentUser.UserId);
        if (_currentUserAccount is not null)
        {
            _canEditEmail = _currentUserAccount.Role == UserRole.Admin;
            _profileFirstName = _currentUserAccount.FirstName ?? "";
            _profileLastName = _currentUserAccount.LastName ?? "";
            _profileEmail = _currentUserAccount.Email ?? "";
        }

        // The Administration settings section is markup-gated (AuthorizeView Roles="Admin"), but
        // that alone wouldn't stop a Member's circuit from fetching this data into this
        // component's state — IsCurrentUserAdminAsync's check avoids ever running these queries
        // for them.
        if (await IsCurrentUserAdminAsync())
        {
            _notesFolderPath = await SettingsService.GetNotesFolderPathAsync();
            await RefreshCountAsync();
            _imageCleanupDays = await SettingsService.GetImageCleanupIntervalDaysAsync();
            _imageCleanupLastRun = await SettingsService.GetImageCleanupLastRunUtcAsync();
            _autoTagStatus = AutoTagStatus.Snapshot;

            _oidc = OidcOptionsAccessor.Value;
            _passwordAuthEnabled = await SettingsService.GetPasswordAuthEnabledAsync();
            await RefreshUsersAsync();
        }
    }

    private async Task<bool> IsCurrentUserAdminAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.IsInRole(nameof(UserRole.Admin));
    }

    private async Task RefreshCountAsync()
    {
        var notes = await NoteService.ListAsync(new NoteSearchQuery());
        _noteCount = notes.Count;
    }

    private async Task RescanAsync()
    {
        _isRescanning = true;
        _lastResult = await Reconciler.RescanAsync(CurrentUser.UserId);
        await RefreshCountAsync();
        _isRescanning = false;
    }

    private async Task SaveImageCleanupIntervalAsync()
    {
        try
        {
            await SettingsService.SetImageCleanupIntervalDaysAsync(_imageCleanupDays);
            _imageCleanupSettingError = false;
            _imageCleanupSettingMessage = ImageCleanupSchedule.IsEnabled(_imageCleanupDays)
                ? $"Unused images will be cleaned up every {_imageCleanupDays} day(s)."
                : "Automatic image cleanup is off.";
        }
        catch (ArgumentOutOfRangeException)
        {
            _imageCleanupSettingError = true;
            _imageCleanupSettingMessage = $"Enter a whole number of days from {ImageCleanupSchedule.DisabledIntervalDays} to {ImageCleanupSchedule.MaxIntervalDays}.";
        }
    }

    private async Task CleanUpImagesAsync()
    {
        _isCleaningImages = true;
        _imageCleanupError = null;
        try
        {
            _imageCleanupResult = await ImageCleanup.CleanUpAllUsersAsync(ImageCleanupSchedule.MinImageAge);
            _imageCleanupLastRun = await SettingsService.GetImageCleanupLastRunUtcAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _imageCleanupResult = null;
            _imageCleanupError = $"Couldn't clean up images: {ex.Message}";
        }
        finally
        {
            _isCleaningImages = false;
        }
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024.0):0.#} MB",
    };

    private async Task SaveProfileAsync()
    {
        _isSavingProfile = true;
        _profileError = null;

        var firstName = string.IsNullOrWhiteSpace(_profileFirstName) ? null : _profileFirstName.Trim();
        var lastName = string.IsNullOrWhiteSpace(_profileLastName) ? null : _profileLastName.Trim();
        // If email isn't editable, send back exactly what's already on the account rather than the
        // (disabled, but still present) input's value — belt-and-suspenders alongside the
        // server-side check in IUserManagementService, not a substitute for it.
        var email = _canEditEmail
            ? (string.IsNullOrWhiteSpace(_profileEmail) ? null : _profileEmail.Trim())
            : _currentUserAccount!.Email;

        try
        {
            await UserManagementService.UpdateProfileAsync(CurrentUser.UserId, CurrentUser.UserId, firstName, lastName, email);

            // Forced full reload so NavMenu's displayed name (which reads the freshly-saved first
            // name) refreshes immediately — it's part of MainLayout, a sibling that a normal
            // in-circuit re-render of this page alone wouldn't touch.
            NavigationManager.NavigateTo("/settings", forceLoad: true);
        }
        catch (DuplicateEmailException)
        {
            _profileError = $"Email '{email}' is already in use by another account.";
        }
        catch (InvalidOperationException ex)
        {
            _profileError = ex.Message;
        }
        finally
        {
            _isSavingProfile = false;
        }
    }

    private async Task TogglePasswordAuthAsync(bool enabled)
    {
        _securityError = null;
        try
        {
            await SettingsService.SetPasswordAuthEnabledAsync(enabled);
            _passwordAuthEnabled = enabled;
        }
        catch (InvalidOperationException ex)
        {
            _securityError = ex.Message;

            // The switch already moved under the user's finger; rebuilding it snaps it back to the model.
            _securityVersion++;
        }
    }

    private async Task RefreshUsersAsync()
    {
        _users = await UserRepository.GetAllUsersAsync();
        _adminCount = _users.Count(u => u.Role == UserRole.Admin);
    }

    private async Task CreateUserAsync()
    {
        var username = _newUser.Username.Trim();
        var email = string.IsNullOrWhiteSpace(_newUser.Email) ? null : _newUser.Email.Trim();
        var password = string.IsNullOrWhiteSpace(_newUser.Password) ? null : _newUser.Password;

        if (!UserValidation.IsLowercase(username))
        {
            _createUserError = "Username must be lowercase.";
            return;
        }

        if (email is not null && !UserValidation.IsValidEmail(email))
        {
            _createUserError = "Enter a valid email address.";
            return;
        }

        if (email is null && password is null)
        {
            _createUserError = "Set a password, an email (for OIDC), or both.";
            return;
        }

        _isCreating = true;
        _createUserError = null;
        try
        {
            await UserRepository.CreateUserAsync(username, _newUser.Role, email, password);
            _newUser = new NewUserModel();
            await RefreshUsersAsync();
        }
        catch (DuplicateUsernameException)
        {
            _createUserError = $"Username '{username}' is already taken.";
        }
        catch (DuplicateEmailException)
        {
            _createUserError = $"Email '{email}' is already in use.";
        }
        catch (InvalidUsernameException ex)
        {
            _createUserError = ex.Message;
        }
        catch (InvalidEmailException ex)
        {
            _createUserError = ex.Message;
        }
        finally
        {
            _isCreating = false;
        }
    }

    // The dialogs report Esc/backdrop closes through VisibleChanged; opening is driven by the *Target fields.
    private void OnEditProfileVisibleChanged(bool visible)
    {
        if (!visible)
        {
            _editProfileTarget = null;
        }
    }

    private void OnResetPasswordVisibleChanged(bool visible)
    {
        if (!visible)
        {
            _resetPasswordTarget = null;
        }
    }

    private void OnDeleteVisibleChanged(bool visible)
    {
        if (!visible)
        {
            _deleteTarget = null;
        }
    }

    private void BeginEditProfile(UserAccount user)
    {
        _editProfileTarget = user;
        _editFirstName = user.FirstName ?? "";
        _editLastName = user.LastName ?? "";
        _editEmail = user.Email ?? "";
        _editProfileError = null;
    }

    private async Task ConfirmEditProfileAsync()
    {
        var firstName = string.IsNullOrWhiteSpace(_editFirstName) ? null : _editFirstName.Trim();
        var lastName = string.IsNullOrWhiteSpace(_editLastName) ? null : _editLastName.Trim();
        var email = string.IsNullOrWhiteSpace(_editEmail) ? null : _editEmail.Trim();
        var targetId = _editProfileTarget!.Id;

        try
        {
            await UserManagementService.UpdateProfileAsync(targetId, CurrentUser.UserId, firstName, lastName, email);
            _editProfileTarget = null;

            if (targetId == CurrentUser.UserId)
            {
                // Refresh NavMenu's displayed name — same reasoning as Profile.razor's own save.
                NavigationManager.NavigateTo("/settings", forceLoad: true);
            }
            else
            {
                await RefreshUsersAsync();
            }
        }
        catch (DuplicateEmailException)
        {
            _editProfileError = $"Email '{email}' is already in use by another account.";
        }
        catch (InvalidOperationException ex)
        {
            _editProfileError = ex.Message;
        }
    }

    private void BeginResetPassword(UserAccount user)
    {
        _resetPasswordTarget = user;
        _resetPasswordValue = "";
        _resetPasswordError = null;
    }

    private async Task ConfirmResetPasswordAsync()
    {
        if (_resetPasswordValue.Length < 8)
        {
            _resetPasswordError = "Password must be at least 8 characters.";
            return;
        }

        await UserRepository.SetPasswordAsync(_resetPasswordTarget!.Id, _resetPasswordValue);
        _resetPasswordTarget = null;
    }

    private void BeginDelete(UserAccount user)
    {
        _deleteTarget = user;
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        try
        {
            await UserManagementService.DeleteUserAsync(_deleteTarget!.Id, CurrentUser.UserId);
            _deleteTarget = null;
            await RefreshUsersAsync();
        }
        catch (CannotDeleteSelfException ex)
        {
            _deleteError = ex.Message;
        }
        catch (CannotDeleteLastAdminException ex)
        {
            _deleteError = ex.Message;
        }
    }

    private sealed class NewUserModel
    {
        [Required]
        public string Username { get; set; } = "";

        public UserRole Role { get; set; } = UserRole.Member;

        public string Email { get; set; } = "";

        public string Password { get; set; } = "";
    }
}
