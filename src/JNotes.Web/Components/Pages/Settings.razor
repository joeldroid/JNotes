@page "/settings"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using JNotes.Core
@using Microsoft.Extensions.Options
@inject ISettingsService SettingsService
@inject INoteIndexReconciler Reconciler
@inject INoteService NoteService
@inject IImageCleanupService ImageCleanup
@inject IAppTimeZoneProvider TimeZoneProvider
@inject IUserRepository UserRepository
@inject IUserManagementService UserManagementService
@inject ICurrentUserContext CurrentUser
@inject IOptions<OidcOptions> OidcOptionsAccessor
@inject IOptions<JNotesOptions> JNotesOptionsAccessor
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Settings</PageTitle>

<h1 class="h3 mb-3">Settings</h1>

<section class="mb-5">
    <h2 class="h4 mb-3">App settings</h2>

    <section class="mb-4">
        <h3 class="h5">Appearance</h3>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="darkModeSwitch"
                   checked="@(_theme == AppTheme.Dark)" @onchange="ToggleThemeAsync" />
            <label class="form-check-label" for="darkModeSwitch">Dark mode</label>
        </div>
    </section>

    <section style="max-width: 420px;">
        <h3 class="h5">Account</h3>
        <div class="d-flex gap-2 align-items-end flex-wrap">
            <div class="flex-grow-1">
                <label class="form-label small mb-1">New password</label>
                <input type="password" class="form-control" @bind="_newPassword" @bind:event="oninput" />
            </div>
            <button class="btn btn-outline-primary" @onclick="ChangePasswordAsync">Change password</button>
        </div>
        @if (_passwordChangeMessage is not null)
        {
            <div class="alert @(_passwordChangeError ? "alert-danger" : "alert-success") py-2 mt-2 mb-0">@_passwordChangeMessage</div>
        }
    </section>
</section>

<AuthorizeView Roles="Admin" Context="adminAuthContext">
    <section>
        <h2 class="h4 mb-3">Administration settings</h2>

        <section class="mb-4">
            <h3 class="h5">Security</h3>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" role="switch" id="passwordAuthSwitch"
                       checked="@_passwordAuthEnabled" disabled="@(!_oidc.IsConfigured && _passwordAuthEnabled)"
                       @onchange="TogglePasswordAuthAsync" />
                <label class="form-check-label" for="passwordAuthSwitch">Allow username/password login</label>
            </div>
            @if (!_oidc.IsConfigured)
            {
                <p class="text-body-secondary small">
                    Can't be turned off — OIDC isn't configured (set OIDC_AUTHORITY/OIDC_CLIENT_ID/OIDC_CLIENT_SECRET), so this is the only sign-in method available.
                </p>
            }
            else
            {
                <p class="text-body-secondary small">OIDC is configured against <code>@_oidc.Authority</code>.</p>
            }
            @if (_securityError is not null)
            {
                <div class="alert alert-danger py-2">@_securityError</div>
            }
        </section>

        <section class="mb-4">
            <h3 class="h5">Storage</h3>
            <p class="mb-1"><strong>Notes folder:</strong> <code>@_notesFolderPath</code></p>
            <p class="text-body-secondary small">Changing the notes folder requires an app restart to take effect.</p>
            <p class="mb-0"><strong>Notes indexed:</strong> @_noteCount</p>
        </section>

        <section class="mb-4">
            <h3 class="h5">Index</h3>
            <p class="text-body-secondary small">
                The index is rebuilt automatically at startup@(JNotesOptionsAccessor.Value.AutoIndexIntervalMinutes > 0 ? $" and every {JNotesOptionsAccessor.Value.AutoIndexIntervalMinutes} minute(s)" : ""). Use this if you've added, edited, or removed
                note files directly on disk while the app is running.
            </p>
            <button class="btn btn-outline-primary" @onclick="RescanAsync" disabled="@_isRescanning">
                @(_isRescanning ? "Rescanning…" : "Rescan Now")
            </button>

            @if (_lastResult is { } result)
            {
                <div class="alert @(result.Errors.Count > 0 ? "alert-warning" : "alert-success") mt-3 mb-0">
                    <div>Added @result.Added, updated @result.Updated, removed @result.Removed.</div>
                    @if (result.Errors.Count > 0)
                    {
                        <ul class="mb-0 mt-2">
                            @foreach (var error in result.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>
            }
        </section>

        <section class="mb-4">
            <h3 class="h5">Images</h3>
            <p class="text-body-secondary small">
                Deleting a note (even permanently) never deletes the images pasted into it, because the same
                image can be used by several notes. Instead, images that no note or trashed note uses any more
                are removed for <strong>all users</strong> on a schedule. Images added in the last
                @((int)ImageCleanupSchedule.MinImageAge.TotalMinutes) minutes are always kept.
            </p>

            <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                <label for="imageCleanupDays" class="form-label mb-0">Clean up every</label>
                <input id="imageCleanupDays" type="number" class="form-control" style="width: 6rem;"
                       min="@ImageCleanupSchedule.DisabledIntervalDays" max="@ImageCleanupSchedule.MaxIntervalDays"
                       @bind="_imageCleanupDays" @bind:event="oninput" />
                <span>day(s)</span>
                <button class="btn btn-primary" @onclick="SaveImageCleanupIntervalAsync">Save</button>
            </div>
            <p class="text-body-secondary small mb-2">
                Enter 0 to turn the automatic cleanup off (@ImageCleanupSchedule.MaxIntervalDays days at most). Default: @ImageCleanupSchedule.DefaultIntervalDays.
            </p>
            @if (_imageCleanupSettingMessage is not null)
            {
                <div class="alert @(_imageCleanupSettingError ? "alert-danger" : "alert-success") py-2">@_imageCleanupSettingMessage</div>
            }

            <p class="mb-2">
                <strong>Last cleanup:</strong>
                @(_imageCleanupLastRun is { } lastRun
                    ? TimeZoneProvider.ToAppTimeZone(lastRun).ToString("f")
                    : "not yet")
            </p>
            <button class="btn btn-outline-primary" @onclick="CleanUpImagesAsync" disabled="@_isCleaningImages">
                @(_isCleaningImages ? "Cleaning up…" : "Clean up now")
            </button>

            @if (_imageCleanupError is not null)
            {
                <div class="alert alert-danger mt-3 mb-0">@_imageCleanupError</div>
            }
            else if (_imageCleanupResult is { } cleanup)
            {
                <div class="alert @(cleanup.UsersFailed > 0 ? "alert-warning" : "alert-success") mt-3 mb-0">
                    <div>
                        @(cleanup.Deleted == 0
                            ? "No unused images found."
                            : $"Removed {cleanup.Deleted} unused image{(cleanup.Deleted == 1 ? "" : "s")}, freeing {FormatBytes(cleanup.BytesFreed)}.")
                    </div>
                    @if (cleanup.SkippedRecent > 0)
                    {
                        <div class="small">
                            @cleanup.SkippedRecent recent image@(cleanup.SkippedRecent == 1 ? " was" : "s were") kept for now — run this again in a few minutes.
                        </div>
                    }
                    @if (cleanup.UsersFailed > 0)
                    {
                        <div class="small">Cleanup failed for @cleanup.UsersFailed user(s) — see the server log.</div>
                    }
                </div>
            }
        </section>

        <section class="mb-4">
            <h3 class="h5">User management</h3>

            <table class="table align-middle" style="max-width: 900px;">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Auth methods</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in _users)
                    {
                        var isSelf = user.Id == CurrentUser.UserId;
                        var isLastAdmin = user.Role == UserRole.Admin && _adminCount <= 1;
                        var name = string.Join(" ", new[] { user.FirstName, user.LastName }.Where(n => !string.IsNullOrWhiteSpace(n)));

                        <tr>
                            <td>@user.Username @(isSelf ? "(you)" : "")</td>
                            <td>@(name.Length > 0 ? name : "—")</td>
                            <td>@user.Role</td>
                            <td>@(user.Email ?? "—")</td>
                            <td>
                                @(user.PasswordHash is not null ? "Password" : "")
                                @(user.PasswordHash is not null && user.OidcSubject is not null ? " + " : "")
                                @(user.OidcSubject is not null ? "OIDC" : "")
                            </td>
                            <td>@user.CreatedAt.LocalDateTime.ToString("d")</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => BeginEditProfile(user)">Edit profile</button>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => BeginResetPassword(user)">Reset password</button>
                                <button class="btn btn-sm btn-outline-danger" disabled="@(isSelf || isLastAdmin)" @onclick="() => BeginDelete(user)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <section style="max-width: 420px;">
                <h4 class="h6">Add user</h4>
                <EditForm Model="_newUser" OnValidSubmit="CreateUserAsync">
                    <DataAnnotationsValidator />
                    @if (_createUserError is not null)
                    {
                        <div class="alert alert-danger py-2">@_createUserError</div>
                    }
                    <div class="mb-2">
                        <label class="form-label">Username <span class="text-body-secondary small">(lowercase only)</span></label>
                        <InputText class="form-control" @bind-Value="_newUser.Username" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Role</label>
                        <InputSelect class="form-select" @bind-Value="_newUser.Role">
                            <option value="@UserRole.Member">Member</option>
                            <option value="@UserRole.Admin">Admin</option>
                        </InputSelect>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Email <span class="text-body-secondary small">(needed to link an OIDC sign-in later)</span></label>
                        <InputText class="form-control" @bind-Value="_newUser.Email" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Password <span class="text-body-secondary small">(leave blank for an OIDC-only account)</span></label>
                        <InputText type="password" class="form-control" @bind-Value="_newUser.Password" />
                    </div>
                    <button type="submit" class="btn btn-outline-primary" disabled="@_isCreating">Add user</button>
                </EditForm>
            </section>
        </section>
    </section>
</AuthorizeView>

@if (_editProfileTarget is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit profile for @_editProfileTarget.Username</h5>
                    <button type="button" class="btn-close" @onclick="() => _editProfileTarget = null"></button>
                </div>
                <div class="modal-body">
                    @if (_editProfileError is not null)
                    {
                        <div class="alert alert-danger py-2">@_editProfileError</div>
                    }
                    <div class="mb-2">
                        <label class="form-label">First name</label>
                        <input class="form-control" @bind="_editFirstName" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Last name</label>
                        <input class="form-control" @bind="_editLastName" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Email</label>
                        <input class="form-control" @bind="_editEmail" @bind:event="oninput" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _editProfileTarget = null">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmEditProfileAsync">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_resetPasswordTarget is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reset password for @_resetPasswordTarget.Username</h5>
                    <button type="button" class="btn-close" @onclick="() => _resetPasswordTarget = null"></button>
                </div>
                <div class="modal-body">
                    @if (_resetPasswordError is not null)
                    {
                        <div class="alert alert-danger py-2">@_resetPasswordError</div>
                    }
                    <label class="form-label">New password</label>
                    <input type="password" class="form-control" @bind="_resetPasswordValue" @bind:event="oninput" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _resetPasswordTarget = null">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmResetPasswordAsync">Set password</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_deleteTarget is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete @_deleteTarget.Username?</h5>
                    <button type="button" class="btn-close" @onclick="() => _deleteTarget = null"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Their notes won't be deleted — the folder is moved aside
                        (<code>notes/deleted/@_deleteTarget.Id/</code>) and their account is removed.
                    </p>
                    @if (_deleteError is not null)
                    {
                        <div class="alert alert-danger py-2">@_deleteError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _deleteTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // App settings
    private string _theme = AppTheme.Dark;

    private string _newPassword = "";
    private string? _passwordChangeMessage;
    private bool _passwordChangeError;

    // Administration settings
    private string _notesFolderPath = "";
    private int _noteCount;
    private bool _isRescanning;
    private ReconciliationResult? _lastResult;

    private int _imageCleanupDays;
    private DateTimeOffset? _imageCleanupLastRun;
    private string? _imageCleanupSettingMessage;
    private bool _imageCleanupSettingError;
    private bool _isCleaningImages;
    private AllUsersImageCleanupResult? _imageCleanupResult;
    private string? _imageCleanupError;

    private bool _passwordAuthEnabled;
    private OidcOptions _oidc = new();
    private string? _securityError;

    private IReadOnlyList<UserAccount> _users = [];
    private int _adminCount;

    private NewUserModel _newUser = new();
    private bool _isCreating;
    private string? _createUserError;

    private UserAccount? _editProfileTarget;
    private string _editFirstName = "";
    private string _editLastName = "";
    private string _editEmail = "";
    private string? _editProfileError;

    private UserAccount? _resetPasswordTarget;
    private string _resetPasswordValue = "";
    private string? _resetPasswordError;

    private UserAccount? _deleteTarget;
    private string? _deleteError;

    protected override async Task OnInitializedAsync()
    {
        _theme = await SettingsService.GetThemeAsync(CurrentUser.UserId);

        // The Administration settings section is markup-gated (AuthorizeView Roles="Admin"), but
        // that alone wouldn't stop a Member's circuit from fetching this data into this
        // component's state — IsCurrentUserAdminAsync's check avoids ever running these queries
        // for them.
        if (await IsCurrentUserAdminAsync())
        {
            _notesFolderPath = await SettingsService.GetNotesFolderPathAsync();
            await RefreshCountAsync();
            _imageCleanupDays = await SettingsService.GetImageCleanupIntervalDaysAsync();
            _imageCleanupLastRun = await SettingsService.GetImageCleanupLastRunUtcAsync();

            _oidc = OidcOptionsAccessor.Value;
            _passwordAuthEnabled = await SettingsService.GetPasswordAuthEnabledAsync();
            await RefreshUsersAsync();
        }
    }

    private async Task<bool> IsCurrentUserAdminAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.IsInRole(nameof(UserRole.Admin));
    }

    private async Task ToggleThemeAsync(ChangeEventArgs e)
    {
        _theme = e.Value is true ? AppTheme.Dark : AppTheme.Light;
        await SettingsService.SetThemeAsync(CurrentUser.UserId, _theme);

        // Applies instantly without a reload — the <html> element persists across in-app
        // navigation under InteractiveServer, so this sticks until a real page reload, at which
        // point App.razor reads the now-persisted setting server-side anyway.
        await JSRuntime.InvokeVoidAsync("document.documentElement.setAttribute", "data-bs-theme", _theme);
    }

    private async Task RefreshCountAsync()
    {
        var notes = await NoteService.ListAsync(new NoteSearchQuery());
        _noteCount = notes.Count;
    }

    private async Task RescanAsync()
    {
        _isRescanning = true;
        _lastResult = await Reconciler.RescanAsync(CurrentUser.UserId);
        await RefreshCountAsync();
        _isRescanning = false;
    }

    private async Task SaveImageCleanupIntervalAsync()
    {
        try
        {
            await SettingsService.SetImageCleanupIntervalDaysAsync(_imageCleanupDays);
            _imageCleanupSettingError = false;
            _imageCleanupSettingMessage = ImageCleanupSchedule.IsEnabled(_imageCleanupDays)
                ? $"Unused images will be cleaned up every {_imageCleanupDays} day(s)."
                : "Automatic image cleanup is off.";
        }
        catch (ArgumentOutOfRangeException)
        {
            _imageCleanupSettingError = true;
            _imageCleanupSettingMessage = $"Enter a whole number of days from {ImageCleanupSchedule.DisabledIntervalDays} to {ImageCleanupSchedule.MaxIntervalDays}.";
        }
    }

    private async Task CleanUpImagesAsync()
    {
        _isCleaningImages = true;
        _imageCleanupError = null;
        try
        {
            _imageCleanupResult = await ImageCleanup.CleanUpAllUsersAsync(ImageCleanupSchedule.MinImageAge);
            _imageCleanupLastRun = await SettingsService.GetImageCleanupLastRunUtcAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _imageCleanupResult = null;
            _imageCleanupError = $"Couldn't clean up images: {ex.Message}";
        }
        finally
        {
            _isCleaningImages = false;
        }
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024.0):0.#} MB",
    };

    private async Task ChangePasswordAsync()
    {
        if (_newPassword.Length < 8)
        {
            _passwordChangeError = true;
            _passwordChangeMessage = "Password must be at least 8 characters.";
            return;
        }

        await UserRepository.SetPasswordAsync(CurrentUser.UserId, _newPassword);
        _newPassword = "";
        _passwordChangeError = false;
        _passwordChangeMessage = "Password changed.";
    }

    private async Task TogglePasswordAuthAsync(ChangeEventArgs e)
    {
        var enabled = e.Value is true;
        _securityError = null;
        try
        {
            await SettingsService.SetPasswordAuthEnabledAsync(enabled);
            _passwordAuthEnabled = enabled;
        }
        catch (InvalidOperationException ex)
        {
            _securityError = ex.Message;
        }
    }

    private async Task RefreshUsersAsync()
    {
        _users = await UserRepository.GetAllUsersAsync();
        _adminCount = _users.Count(u => u.Role == UserRole.Admin);
    }

    private async Task CreateUserAsync()
    {
        var username = _newUser.Username.Trim();
        var email = string.IsNullOrWhiteSpace(_newUser.Email) ? null : _newUser.Email.Trim();
        var password = string.IsNullOrWhiteSpace(_newUser.Password) ? null : _newUser.Password;

        if (!UserValidation.IsLowercase(username))
        {
            _createUserError = "Username must be lowercase.";
            return;
        }

        if (email is not null && !UserValidation.IsValidEmail(email))
        {
            _createUserError = "Enter a valid email address.";
            return;
        }

        if (email is null && password is null)
        {
            _createUserError = "Set a password, an email (for OIDC), or both.";
            return;
        }

        _isCreating = true;
        _createUserError = null;
        try
        {
            await UserRepository.CreateUserAsync(username, _newUser.Role, email, password);
            _newUser = new NewUserModel();
            await RefreshUsersAsync();
        }
        catch (DuplicateUsernameException)
        {
            _createUserError = $"Username '{username}' is already taken.";
        }
        catch (DuplicateEmailException)
        {
            _createUserError = $"Email '{email}' is already in use.";
        }
        catch (InvalidUsernameException ex)
        {
            _createUserError = ex.Message;
        }
        catch (InvalidEmailException ex)
        {
            _createUserError = ex.Message;
        }
        finally
        {
            _isCreating = false;
        }
    }

    private void BeginEditProfile(UserAccount user)
    {
        _editProfileTarget = user;
        _editFirstName = user.FirstName ?? "";
        _editLastName = user.LastName ?? "";
        _editEmail = user.Email ?? "";
        _editProfileError = null;
    }

    private async Task ConfirmEditProfileAsync()
    {
        var firstName = string.IsNullOrWhiteSpace(_editFirstName) ? null : _editFirstName.Trim();
        var lastName = string.IsNullOrWhiteSpace(_editLastName) ? null : _editLastName.Trim();
        var email = string.IsNullOrWhiteSpace(_editEmail) ? null : _editEmail.Trim();
        var targetId = _editProfileTarget!.Id;

        try
        {
            await UserManagementService.UpdateProfileAsync(targetId, CurrentUser.UserId, firstName, lastName, email);
            _editProfileTarget = null;

            if (targetId == CurrentUser.UserId)
            {
                // Refresh NavMenu's displayed name — same reasoning as Profile.razor's own save.
                NavigationManager.NavigateTo("/settings", forceLoad: true);
            }
            else
            {
                await RefreshUsersAsync();
            }
        }
        catch (DuplicateEmailException)
        {
            _editProfileError = $"Email '{email}' is already in use by another account.";
        }
        catch (InvalidOperationException ex)
        {
            _editProfileError = ex.Message;
        }
    }

    private void BeginResetPassword(UserAccount user)
    {
        _resetPasswordTarget = user;
        _resetPasswordValue = "";
        _resetPasswordError = null;
    }

    private async Task ConfirmResetPasswordAsync()
    {
        if (_resetPasswordValue.Length < 8)
        {
            _resetPasswordError = "Password must be at least 8 characters.";
            return;
        }

        await UserRepository.SetPasswordAsync(_resetPasswordTarget!.Id, _resetPasswordValue);
        _resetPasswordTarget = null;
    }

    private void BeginDelete(UserAccount user)
    {
        _deleteTarget = user;
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        try
        {
            await UserManagementService.DeleteUserAsync(_deleteTarget!.Id, CurrentUser.UserId);
            _deleteTarget = null;
            await RefreshUsersAsync();
        }
        catch (CannotDeleteSelfException ex)
        {
            _deleteError = ex.Message;
        }
        catch (CannotDeleteLastAdminException ex)
        {
            _deleteError = ex.Message;
        }
    }

    private sealed class NewUserModel
    {
        [Required]
        public string Username { get; set; } = "";

        public UserRole Role { get; set; } = UserRole.Member;

        public string Email { get; set; } = "";

        public string Password { get; set; } = "";
    }
}
