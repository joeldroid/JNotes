@page "/"
@attribute [Authorize]
@inject INoteService NoteService
@inject NavigationManager NavigationManager

<PageTitle>Notes</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <input type="search" class="form-control" style="max-width: 260px;" placeholder="Search notes…"
           @bind="_searchText" @bind:event="oninput" @bind:after="RefreshAsync" />

    <select class="form-select" style="max-width: 160px;" @bind="_typeFilter" @bind:after="RefreshAsync">
        <option value="">All types</option>
        <option value="Text">Text</option>
        <option value="Checklist">Checklist</option>
    </select>

    <select class="form-select" style="max-width: 180px;" @bind="_tagFilter" @bind:after="RefreshAsync">
        <option value="">All tags</option>
        @foreach (var tag in _availableTags)
        {
            <option value="@tag">@tag</option>
        }
    </select>

    <div class="dropdown ms-auto">
        <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            New note
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><button class="dropdown-item" @onclick='() => CreateNoteAsync(NoteType.Text)'>Text note</button></li>
            <li><button class="dropdown-item" @onclick='() => CreateNoteAsync(NoteType.Checklist)'>Checklist</button></li>
        </ul>
    </div>
</div>

@if (_notes is null)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (_notes.Count == 0)
{
    <p class="text-body-secondary">No notes yet — create one to get started.</p>
}
else
{
    <div class="list-group">
        @foreach (var note in _notes)
        {
            <NoteListItem Note="note" />
        }
    </div>
}

@code {
    private IReadOnlyList<NoteSummary>? _notes;
    private IReadOnlyList<string> _availableTags = [];
    private string _searchText = "";
    private string _typeFilter = "";
    private string _tagFilter = "";

    protected override async Task OnInitializedAsync()
    {
        _availableTags = await NoteService.GetDistinctTagsAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var type = Enum.TryParse<NoteType>(_typeFilter, out var parsed) ? parsed : (NoteType?)null;
        var query = new NoteSearchQuery(
            SearchText: string.IsNullOrWhiteSpace(_searchText) ? null : _searchText,
            Tag: string.IsNullOrWhiteSpace(_tagFilter) ? null : _tagFilter,
            Type: type);

        _notes = await NoteService.ListAsync(query);
    }

    private async Task CreateNoteAsync(NoteType type)
    {
        var defaultBody = type == NoteType.Checklist ? "- [ ] " : "";
        var note = await NoteService.CreateAsync(type, "Untitled note", [], defaultBody);
        NavigationManager.NavigateTo($"/notes/{note.Id}");
    }
}
