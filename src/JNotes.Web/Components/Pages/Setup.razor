@page "/setup"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IUserRepository UserRepository
@inject NavigationManager Navigation

<PageTitle>Set up JNotes</PageTitle>

<div class="auth-card mud-paper mud-elevation-2">
    <div class="auth-logo">
        <img src="@Assets["img/jnotes-logo-512.png"]" alt="" />
    </div>
    <h1 class="auth-title mud-typography mud-typography-h5">Welcome to JNotes</h1>
    <p class="auth-subtitle mud-typography mud-typography-body2">Create the first admin account to get started.</p>

    <EditForm Model="Model" FormName="setup" OnValidSubmit="HandleSetupAsync" class="auth-form">
        <DataAnnotationsValidator />
        @if (_error is not null)
        {
            <div class="auth-alert auth-alert-error" role="alert">@_error</div>
        }
        <div class="auth-field">
            <label for="username">Username (Lowercase only)</label>
            <InputText id="username" class="auth-input" @bind-Value="Model!.Username" autofocus />
        </div>
        <div class="auth-field">
            <label for="email">Email</label>
            <InputText id="email" class="auth-input" @bind-Value="Model!.Email" />
        </div>
        <div class="auth-field">
            <label for="password">Password</label>
            <InputText id="password" type="password" class="auth-input" @bind-Value="Model!.Password" />
        </div>
        <div class="auth-field">
            <label for="confirmPassword">Confirm password</label>
            <InputText id="confirmPassword" type="password" class="auth-input" @bind-Value="Model!.ConfirmPassword" />
        </div>
        <button type="submit" class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-full-width">
            <span class="mud-button-label">Create admin account</span>
        </button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private SetupModel? Model { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? _error;

    protected override void OnInitialized()
    {
        // The setup-gate middleware (Program.cs) redirects a stale/bookmarked /setup away once an
        // admin exists — before this component ever renders — so there's no "already complete"
        // case to guard here. It also owns the opposite "not yet set up" direction, so both
        // directions live in one place instead of half here and half there.

        // [SupplyParameterFromForm] can hand back null (e.g. the first GET, before any POST) — a
        // property initializer wouldn't survive that, so it's assigned here instead.
        Model ??= new SetupModel();
    }

    private async Task HandleSetupAsync()
    {
        var username = Model!.Username.Trim();
        var email = Model.Email.Trim();

        if (!UserValidation.IsLowercase(username))
        {
            _error = "Username must be lowercase.";
            return;
        }

        if (!UserValidation.IsValidEmail(email))
        {
            _error = "Enter a valid email address.";
            return;
        }

        if (Model.Password != Model.ConfirmPassword)
        {
            _error = "Passwords don't match.";
            return;
        }

        if (Model.Password.Length < 8)
        {
            _error = "Password must be at least 8 characters.";
            return;
        }

        UserAccount admin;
        try
        {
            admin = await UserRepository.CreateUserAsync(username, UserRole.Admin, email, password: Model.Password);
        }
        catch (DuplicateUsernameException)
        {
            _error = $"Username '{username}' is already taken.";
            return;
        }
        catch (InvalidUsernameException ex)
        {
            _error = ex.Message;
            return;
        }
        catch (InvalidEmailException ex)
        {
            _error = ex.Message;
            return;
        }

        var principal = ClaimsPrincipalFactory.Create(admin, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal,
            new AuthenticationProperties { IsPersistent = true });

        Navigation.NavigateTo("/", forceLoad: true);
    }

    private sealed class SetupModel
    {
        [Required]
        public string Username { get; set; } = "";

        [Required]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";

        [Required]
        public string ConfirmPassword { get; set; } = "";
    }
}
