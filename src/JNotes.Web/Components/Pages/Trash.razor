@page "/trash"
@attribute [Authorize]
@inject INoteService NoteService
@inject IAppTimeZoneProvider TimeZoneProvider
@inject IDialogService DialogService

<PageTitle>Trash</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-1">Trash</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Notes here can be restored or permanently deleted.</MudText>

@if (_trashedNotes is null)
{
    <MudText Color="Color.Secondary">Loading…</MudText>
}
else if (_trashedNotes.Count == 0)
{
    <MudText Color="Color.Secondary">Trash is empty.</MudText>
}
else
{
    <div class="jn-note-list">
        @foreach (var note in _trashedNotes)
        {
            <MudPaper Outlined="true" Class="jn-trash-item">
                <div class="jn-note-main">
                    <div class="jn-note-title">
                        <strong>@(string.IsNullOrWhiteSpace(note.Title) ? "Untitled note" : note.Title)</strong>
                    </div>
                    @if (note.Tags.Count > 0)
                    {
                        <div class="jn-tags">
                            @foreach (var tag in note.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                            }
                        </div>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">Deleted @TimeZoneProvider.ToAppTimeZone(note.TrashedAt).DateTime.ToString("g")</MudText>
                </div>
                <MudStack Row="true" Spacing="2" Class="flex-shrink-0">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => RestoreAsync(note.Id)">Restore</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => PurgeAsync(note)">Delete forever</MudButton>
                </MudStack>
            </MudPaper>
        }
    </div>
}

@code {
    private IReadOnlyList<TrashedNoteSummary>? _trashedNotes;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync() => _trashedNotes = await NoteService.ListTrashAsync();

    private async Task RestoreAsync(Guid id)
    {
        await NoteService.RestoreAsync(id);
        await RefreshAsync();
    }

    private async Task PurgeAsync(TrashedNoteSummary note)
    {
        var name = string.IsNullOrWhiteSpace(note.Title) ? "Untitled note" : note.Title;

        // true = "Delete forever"; anything else (Cancel, Esc, backdrop click) leaves the note alone.
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Permanently delete \"{name}\"?",
            "This can't be undone.",
            yesText: "Delete forever",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await NoteService.PurgeAsync(note.Id);
        await RefreshAsync();
    }
}
