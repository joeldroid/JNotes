@page "/notes/{Id:guid}/edit"
@page "/notes/new"
@attribute [Authorize]
@implements IAsyncDisposable
@inject INoteService NoteService
@inject NavigationManager NavigationManager
@inject IAppTimeZoneProvider TimeZoneProvider
@inject IDialogService DialogService

<PageTitle>@(_note?.Title is { Length: > 0 } title ? title : IsNew ? "New note" : "Note")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">This note couldn't be found — it may have been deleted.</MudAlert>
    <MudButton Href="/" Variant="Variant.Outlined">Back to notes</MudButton>
}
else if (_note is null)
{
    <MudText Color="Color.Secondary">Loading…</MudText>
}
else
{
    @if (IsNew)
    {
        @* A new note is an in-memory draft until Save, so leaving the page is the only way to lose it. *@
        <NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="HasDraftContent" />
    }

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
        <div class="jn-title-block jn-editor-fields">
            @if (IsOwner)
            {
                <MudTextField @bind-Value="_note.Title" @bind-Value:after="OnMetadataEdited" Immediate="true"
                              Placeholder="Untitled note" aria-label="Title" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Typo="Typo.h6" Error="@(_titleError is not null)" ErrorText="@_titleError" />
                <div class="mt-2">
                    <TagInput @key="_draftVersion" Tags="_note.Tags" TagsChanged="OnTagsChanged" SuggestTags="SuggestTagsAsync" />
                </div>
            }
            else
            {
                @* An Edit recipient changes the body only: title and tags are read-only text, and TagInput (which has no
                   Disabled parameter) isn't rendered at all, so OnMetadataEdited can never fire for them. *@
                <MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-1">@(string.IsNullOrWhiteSpace(_note.Title) ? "Untitled note" : _note.Title)</MudText>
                @if (_note.Tags.Count > 0)
                {
                    <div class="jn-tags">
                        @foreach (var tag in _note.Tags)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                        }
                    </div>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                    Shared by @_access?.OwnerDisplayName — you can edit the body; only the owner can change the title or tags.
                </MudText>
            }
        </div>
        <div class="jn-editor-actions">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                @if (IsNew)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_isSaving"
                               StartIcon="@Icons.Material.Filled.Save" OnClick="SaveNewAsync">Save</MudButton>
                    <MudButton Href="/" Variant="Variant.Outlined" Color="Color.Error" title="Discard this new note"
                               StartIcon="@Icons.Material.Outlined.Close">Discard</MudButton>
                }
                else
                {
                    <MudButton Href="@($"/notes/{_note.Id}")" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Close">Close</MudButton>
                    @if (IsOwner)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" title="Move to Trash"
                                   StartIcon="@Icons.Material.Outlined.DeleteOutline" OnClick="TrashAsync">Delete</MudButton>
                    }
                }
            </MudStack>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@SaveStatusText</MudText>
            @if (_saveError is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@_saveError</MudText>
            }
        </div>
    </MudStack>

    @if (!IsNew)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">Last updated @TimeZoneProvider.ToAppTimeZone(_note.UpdatedAt).DateTime.ToString("g")</MudText>
    }

    <TextNoteEditor @bind-Body="_note.Body" @bind-Body:after="OnContentEdited"
                    ImagesNoteId="@(IsOwner ? null : _note.Id)" SaveImage="SharedImageSaver" />
}

@code {
    private static readonly TimeSpan ContentDebounceDelay = TimeSpan.FromMilliseconds(800);
    private static readonly TimeSpan MetadataDebounceDelay = TimeSpan.FromMilliseconds(500);

    // null on /notes/new - the note doesn't exist yet, so the page holds an in-memory draft that is never
    // autosaved (Save creates it). The router sets the unused route parameter to null, so a reused instance
    // switches modes correctly.
    [Parameter] public Guid? Id { get; set; }

    private Note? _note;
    // How the current user relates to an existing note (null for a draft, which is always the author's own).
    private NoteAccess? _access;
    // Set once a save found the note gone or the access revoked/downgraded: every further edit and the final flush are skipped.
    private bool _accessLost;
    private bool _notFound;
    private bool _isSaving;
    private bool _hasUnsavedChanges;
    private bool _draftSaved;
    private int _draftVersion;
    private string? _saveError;
    private string? _titleError;

    // Content and metadata autosave debounce independently (typing in the body shouldn't wait on
    // title/tags edits or vice versa), but both ultimately write the same file, so the actual save
    // execution is serialized through one gate rather than risking two overlapping writes.
    private readonly AutosaveDebouncer _contentDebouncer;
    private readonly AutosaveDebouncer _metadataDebouncer;
    private readonly SemaphoreSlim _saveGate = new(1, 1);

    public NoteEditor()
    {
        _contentDebouncer = new AutosaveDebouncer(ContentDebounceDelay, () => SaveNowAsync(NoteSaveScope.ContentOnly));
        _metadataDebouncer = new AutosaveDebouncer(MetadataDebounceDelay, () => SaveNowAsync(NoteSaveScope.Metadata));
    }

    private bool IsNew => Id is null;

    // Drafts, and notes the user owns. False for an Edit recipient (Read recipients never get this far — see OnParametersSetAsync).
    private bool IsOwner => IsNew || _access is null || _access.IsOwner;

    // An Edit recipient's pasted images go to the owner's folder through INoteService; owners use the editor's own IImageService path.
    private Func<Stream, CancellationToken, Task<string>>? SharedImageSaver =>
        IsOwner || _note is null ? null : (stream, ct) => NoteService.SaveImageAsync(_note.Id, stream, ct);

    // Only a draft with something in it is worth a "discard?" prompt; an untouched empty one isn't.
    private bool HasDraftContent =>
        IsNew && !_draftSaved && _note is not null
        && (!string.IsNullOrWhiteSpace(_note.Title)
            || _note.Tags.Count > 0
            || !string.IsNullOrWhiteSpace(_note.Body));

    private string SaveStatusText => IsNew
        ? _isSaving ? "Saving…" : "Not saved yet"
        : _isSaving ? "Saving…" : _hasUnsavedChanges ? "Unsaved changes" : "All changes saved";

    protected override async Task OnParametersSetAsync()
    {
        // Read before the resets below: a loaded note with edits still sitting in a debounce window, about to be
        // replaced by a new draft (the instance is reused between /notes/{id}/edit and /notes/new).
        var unsavedNote = _note is { } current && current.Id != Guid.Empty && !_accessLost && _hasUnsavedChanges ? current : null;

        _notFound = false;
        _saveError = null;
        _titleError = null;
        _accessLost = false;

        if (IsNew)
        {
            _access = null;

            // Switching from a loaded note: its pending debounces would otherwise fire against the draft below
            // (NoteNotFoundException -> _accessLost) and its last edit would be lost. Cancel them, flush that note
            // under the save gate (same best-effort Metadata flush as DisposeAsync), and swap the draft in while
            // still holding the gate so a save queued behind it sees the draft (SaveNowAsync skips drafts).
            _contentDebouncer.Cancel();
            _metadataDebouncer.Cancel();
            await _saveGate.WaitAsync();
            try
            {
                if (unsavedNote is not null)
                {
                    try
                    {
                        await NoteService.AutosaveAsync(unsavedNote, NoteSaveScope.Metadata);
                    }
                    catch
                    {
                        // Best-effort, as in DisposeAsync: the user is already leaving this note.
                    }
                }

                // Built here rather than in OnInitializedAsync: /notes/{id}/edit -> /notes/new
                // reuses this instance and only the parameters change.
                ResetDraft();
            }
            finally
            {
                _saveGate.Release();
            }

            return;
        }

        try
        {
            var result = await NoteService.GetWithAccessAsync(Id!.Value);
            if (result.Access.Level == NoteAccessLevel.Read)
            {
                // A Read recipient can't edit: send them to the read-only view (replace, so Back doesn't bounce them here again).
                _note = null;
                NavigationManager.NavigateTo($"/notes/{Id}", replace: true);
                return;
            }

            _note = result.Note;
            _access = result.Access;
            _hasUnsavedChanges = false;
        }
        catch (NoteNotFoundException)
        {
            _notFound = true;
        }
    }

    private void OnContentEdited()
    {
        if (_accessLost)
        {
            return;
        }

        _hasUnsavedChanges = true;
        if (!IsNew)
        {
            _contentDebouncer.Trigger();
        }
    }

    private void OnMetadataEdited()
    {
        if (_accessLost)
        {
            return;
        }

        _hasUnsavedChanges = true;
        _titleError = null;
        if (!IsNew)
        {
            _metadataDebouncer.Trigger();
        }
    }

    private void OnTagsChanged(IReadOnlyList<string> tags)
    {
        // Pushed into _note.Tags immediately (not just at save time) — a content-only autosave firing
        // while a tag edit is mid-debounce still writes *some* current snapshot of Tags to the file (the
        // file format has no partial write), so it should be the freshest one, not whatever was last
        // actually saved.
        _note!.Tags = tags;
        OnMetadataEdited();
    }

    // The page owns the INoteService call (resolved from its first lifecycle method, see the
    // ICurrentUserContext gotcha); TagInput only receives this delegate.
    private Task<IReadOnlyList<string>> SuggestTagsAsync(string? term, IReadOnlyCollection<string> exclude, CancellationToken ct) =>
        NoteService.SuggestTagsAsync(term, exclude, 10, ct);

    /// <summary>
    /// The single path every autosave of an existing note — either scope — goes through, so the
    /// in-flight/error/dirty status shown in the UI is always accurate regardless of which timer
    /// fired. Safe to call from a debounce's background continuation: <c>InvokeAsync</c> is a
    /// no-op wrapper when already on the right synchronization context. Never reached for a new
    /// note: its debouncers are never triggered.
    /// </summary>
    private async Task SaveNowAsync(NoteSaveScope scope)
    {
        if (_note is null || _accessLost)
        {
            return;
        }

        _isSaving = true;
        await InvokeAsync(StateHasChanged);

        await _saveGate.WaitAsync();
        try
        {
            // A save queued behind the draft swap in OnParametersSetAsync: nothing exists to save for a draft.
            if (_note is null || _note.Id == Guid.Empty)
            {
                return;
            }

            var saved = await NoteService.AutosaveAsync(_note, scope);
            if (!ReferenceEquals(saved, _note))
            {
                // An Edit recipient's save comes back as the owner's file with only the body merged in: adopt the
                // owner's current title/tags (a concurrent rename or auto-tag) but keep the body being typed, which
                // may already be ahead of what was just saved.
                _note.Title = saved.Title;
                _note.Tags = saved.Tags;
                _note.UpdatedAt = saved.UpdatedAt;
            }

            _hasUnsavedChanges = false;
            _saveError = null;
        }
        catch (Exception ex) when (ex is NoteNotFoundException or NoteAccessDeniedException)
        {
            // Unshared, made read-only or deleted while this editor was open — access is re-checked on every save.
            // Nothing was written; stop autosaving and say so loudly, since the latest typing is only in this page.
            _accessLost = true;
            _contentDebouncer.Cancel();
            _metadataDebouncer.Cancel();
            _saveError = "This note is no longer available to you (unshared, made read-only, or deleted). Your latest changes were NOT saved — copy them before leaving.";
        }
        catch (Exception ex)
        {
            // Surfaced, not swallowed — autosave failures shouldn't disappear silently just
            // because nothing was awaiting this particular save.
            _saveError = $"Autosave failed: {ex.Message}";
        }
        finally
        {
            _saveGate.Release();
            _isSaving = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The only place a new note is written. An empty (or whitespace) title is refused so nobody
    /// ends up with an accidental untitled note; on success the draft becomes a real note and the
    /// page hands over to its read-only view.
    /// </summary>
    private async Task SaveNewAsync()
    {
        if (_note is null || _isSaving)
        {
            return;
        }

        var title = _note.Title?.Trim() ?? "";
        if (title.Length == 0)
        {
            _titleError = "Give the note a title before saving.";
            return;
        }

        _isSaving = true;
        _saveError = null;
        try
        {
            var created = await NoteService.CreateAsync(title, _note.Tags, _note.Body);

            // Cleared before navigating so the leave-guard doesn't block Save's own navigation.
            _draftSaved = true;
            _hasUnsavedChanges = false;
            NavigationManager.NavigateTo($"/notes/{created.Id}");
        }
        catch (Exception ex)
        {
            _saveError = $"Couldn't save note: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    // A fresh, empty in-memory draft. _draftVersion keys TagInput so its autocomplete (which keeps its own typed text)
    // is rebuilt too; the native textarea and the title field follow the new model on the next render.
    private void ResetDraft()
    {
        var now = DateTimeOffset.UtcNow;
        _note = new Note { Id = Guid.Empty, Title = "", Tags = [], CreatedAt = now, UpdatedAt = now, Body = "" };
        _hasUnsavedChanges = false;
        _draftSaved = false;
        _saveError = null;
        _titleError = null;
        _draftVersion++;
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (!HasDraftContent)
        {
            return;
        }

        // true = "Discard"; anything else (Keep editing, Esc, backdrop click) stays on the draft.
        var discard = await DialogService.ShowMessageBoxAsync(
            "Discard this new note?",
            "It hasn't been saved.",
            yesText: "Discard",
            cancelText: "Keep editing");
        if (discard != true)
        {
            context.PreventNavigation();
            return;
        }

        // New Note while already on /notes/new is a same-URL navigation: the router hands this mounted instance
        // identical parameters, so OnParametersSetAsync never runs and the old draft would stay on screen after
        // "Discard". Reset it here. A confirmed navigation anywhere else leaves the page, so nothing to reset.
        if (IsNew && IsNewNoteRoute(context.TargetLocation))
        {
            ResetDraft();
            StateHasChanged();
        }
    }

    private bool IsNewNoteRoute(string targetLocation)
    {
        var relative = NavigationManager.ToBaseRelativePath(targetLocation);
        var end = relative.IndexOfAny(['?', '#']);
        return (end < 0 ? relative : relative[..end]).TrimEnd('/') == "notes/new";
    }

    private async Task TrashAsync()
    {
        if (_note is null)
        {
            return;
        }

        // true = "Delete"; anything else (Cancel, Esc, backdrop click) leaves the note alone.
        var name = string.IsNullOrWhiteSpace(_note.Title) ? "Untitled note" : _note.Title;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Delete \"{name}\"?",
            "It will be moved to Trash, where you can restore it.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        // Cancel any pending autosave and wait for one already in flight to finish, so trashing
        // can never race an autosave write (which could otherwise resurrect the file, or throw
        // against one that's already been moved).
        _contentDebouncer.Cancel();
        _metadataDebouncer.Cancel();
        await _saveGate.WaitAsync();
        try
        {
            await NoteService.TrashAsync(_note.Id);
        }
        finally
        {
            _saveGate.Release();
        }

        NavigationManager.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        _contentDebouncer.Dispose();
        _metadataDebouncer.Dispose();

        // A new note is a draft: leaving without Save must not create it, so there's nothing to flush.
        if (!IsNew && !_accessLost && _hasUnsavedChanges && _note is not null)
        {
            // Best-effort final flush so navigating away right after typing doesn't lose the last
            // stretch of edits — always the full scope, so the index isn't left stale either.
            try
            {
                await _saveGate.WaitAsync();
                try
                {
                    await NoteService.AutosaveAsync(_note, NoteSaveScope.Metadata);
                }
                finally
                {
                    _saveGate.Release();
                }
            }
            catch
            {
                // Nothing left to show this to — the component's already tearing down.
            }
        }

        _saveGate.Dispose();
    }
}
