@page "/notes/{Id:guid}"
@attribute [Authorize]
@using Microsoft.Extensions.Options
@inject INoteService NoteService
@inject INoteSharingService SharingService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IAppTimeZoneProvider TimeZoneProvider
@inject IOptions<PdfExportOptions> PdfExportOptions

<PageTitle>@(_note?.Title is { Length: > 0 } title ? title : "Note")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">This note couldn't be found — it may have been deleted.</MudAlert>
    <MudButton Href="/" Variant="Variant.Outlined">Back to notes</MudButton>
}
else if (_note is null || _access is null)
{
    <MudText Color="Color.Secondary">Loading…</MudText>
}
else
{
    <div class="note-view">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
            <div class="jn-title-block">
                <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-1">@(string.IsNullOrWhiteSpace(_note.Title) ? "Untitled note" : _note.Title)</MudText>
                @if (_note.Tags.Count > 0)
                {
                    <div class="jn-tags">
                        @foreach (var tag in _note.Tags)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                        }
                    </div>
                }
            </div>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="flex-shrink-0">
                @if (_access.CanEditBody)
                {
                    <MudButton Href="@($"/notes/{_note.Id}/edit")" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                }
                @if (_access.IsOwner)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" title="Share this note"
                               StartIcon="@Icons.Material.Outlined.PersonAdd" OnClick="OpenShare">@(_shares.Count > 0 ? $"Shared with {_shares.Count}" : "Share")</MudButton>
                }
                @if (PdfExportOptions.Value.IsEnabled)
                {
                    @* A plain new-tab anchor to /notes/{id}/pdf (not an @onclick): the PDF reflects the file at click time, so checklist changes made on this page are included. *@
                    <MudButton Href="@($"/notes/{Id}/pdf")" Target="_blank" Rel="noopener" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.PictureAsPdf" title="Export as PDF (opens in a new tab)">Export PDF</MudButton>
                }
                @if (_access.IsOwner)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" title="Move to Trash" Disabled="_isDeleting"
                               StartIcon="@Icons.Material.Outlined.DeleteOutline" OnClick="TrashAsync">Delete</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" title="Stop having access to this note" Disabled="_isDeleting"
                               StartIcon="@Icons.Material.Outlined.ExitToApp" OnClick="LeaveAsync">Leave</MudButton>
                }
            </MudStack>
        </MudStack>

        <div class="jn-meta">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled">@(_note.Type == NoteType.Checklist ? "Checklist" : "Text")</MudChip>
            @if (!_access.IsOwner)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                         Icon="@Icons.Material.Outlined.People">Shared by @_access.OwnerDisplayName · @(_access.Level == NoteAccessLevel.Edit ? "Can edit" : "View only")</MudChip>
            }
            <MudText Typo="Typo.caption" Color="Color.Secondary">Last updated @TimeZoneProvider.ToAppTimeZone(_note.UpdatedAt).DateTime.ToString("g")</MudText>
        </div>

        @if (_actionError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_actionError</MudAlert>
        }

        @if (_note.Type == NoteType.Checklist)
        {
            // Checking items is the one change allowed from the view — it goes through NoteService,
            // never a free body edit (that stays in the editor). A Read recipient's panel is inert.
            <MudPaper Outlined="true" Class="pa-3">
                <ChecklistPanel Body="@_note.Body" Disabled="_isMutating" ReadOnly="@(!_access.CanEditBody)" OnItemChecked="SetItemCheckedAsync" />
            </MudPaper>
        }
        else
        {
            <MarkdownPreview Markdown="@_note.Body" ImagesNoteId="@(_access.IsOwner ? null : _note.Id)" />
        }
    </div>

    @if (_access.IsOwner)
    {
        @* Rendered only for the owner, so a recipient's circuit never gets this dialog's handler ids (the UI gating is
           secondary — INoteSharingService re-checks ownership on every call). *@
        <MudDialog Visible="_shareOpen" VisibleChanged="OnShareVisibleChanged" Options="_dialogOptions">
            <TitleContent>Share “@(string.IsNullOrWhiteSpace(_note.Title) ? "Untitled note" : _note.Title)”</TitleContent>
            <DialogContent>
                <MudStack Spacing="2">
                    @if (_shareError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@_shareError</MudAlert>
                    }
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        People you share with can read this note; with “Can edit” they can also change its text or checklist items.
                        Only you can rename, retag, share or delete it.
                    </MudText>
                    <NoteSharePanel Shares="_shares" SearchRecipients="SearchRecipientsAsync" Disabled="_sharesBusy" Version="_sharesVersion"
                                    OnShare="SetShareAsync" OnPermissionChanged="SetShareAsync" OnRemove="RemoveShareAsync" />
                </MudStack>
            </DialogContent>
            <DialogActions>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CloseShare">Done</MudButton>
            </DialogActions>
        </MudDialog>
    }
}

@code {
    private static readonly DialogOptions _dialogOptions = new()
    {
        CloseOnEscapeKey = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Small,
    };

    [Parameter] public Guid Id { get; set; }

    private Note? _note;
    private NoteAccess? _access;
    private bool _notFound;
    private bool _isDeleting;
    private bool _isMutating;
    private string? _actionError;

    // Owner only: the note's recipients, and the share dialog's state. _sharesVersion goes into each row's @key
    // (NoteSharePanel) so a MudSelect the server refused to change is rebuilt from the model.
    private IReadOnlyList<NoteShareEntry> _shares = [];
    private bool _shareOpen;
    private bool _sharesBusy;
    private int _sharesVersion;
    private string? _shareError;

    protected override async Task OnParametersSetAsync()
    {
        _notFound = false;
        _actionError = null;
        _shareOpen = false;
        _shareError = null;
        _shares = [];
        try
        {
            var result = await NoteService.GetWithAccessAsync(Id);
            _note = result.Note;
            _access = result.Access;
            if (_access.IsOwner)
            {
                _shares = await SharingService.ListSharesAsync(Id);
            }
        }
        catch (NoteNotFoundException)
        {
            _notFound = true;
        }
    }

    private Task SetItemCheckedAsync((int LineIndex, bool IsChecked) change) =>
        MutateChecklistAsync(
            () => NoteService.SetChecklistItemCheckedAsync(Id, change.LineIndex, change.IsChecked),
            "update the checklist");

    private async Task MutateChecklistAsync(Func<Task<Note>> mutation, string action)
    {
        if (_note is null || _isMutating)
        {
            return;
        }

        // The panel disables its controls while a mutation is in flight, so two quick clicks can't
        // race each other's file write (the editor serializes through a gate for the same reason).
        _isMutating = true;
        _actionError = null;
        try
        {
            var result = await mutation();
            _note.Body = result.Body;
            _note.UpdatedAt = result.UpdatedAt;
        }
        catch (Exception ex) when (ex is NoteNotFoundException or NoteAccessDeniedException)
        {
            // Unshared, made read-only or deleted since this page loaded (access is re-checked on every call).
            _actionError = "Your access to this note has changed — reload the page.";
        }
        catch (Exception ex)
        {
            _actionError = $"Couldn't {action}: {ex.Message}";
        }
        finally
        {
            _isMutating = false;
        }
    }

    private void OpenShare()
    {
        _shareError = null;
        _shareOpen = true;
    }

    private void CloseShare() => _shareOpen = false;

    // The dialog reports Esc/backdrop closes through VisibleChanged; opening is driven by OpenShare.
    private void OnShareVisibleChanged(bool visible) => _shareOpen = visible;

    // The page owns the INoteSharingService calls; NoteSharePanel only receives this delegate.
    private Task<IReadOnlyList<ShareRecipientCandidate>> SearchRecipientsAsync(string? term, CancellationToken cancellationToken) =>
        SharingService.SearchRecipientsAsync(Id, term, 10, cancellationToken);

    // ShareAsync is an upsert, so adding someone and changing their permission are the same call.
    private Task SetShareAsync((Guid UserId, NoteSharePermission Permission) request) =>
        MutateSharesAsync(() => SharingService.ShareAsync(Id, request.UserId, request.Permission));

    private Task RemoveShareAsync(Guid userId) =>
        MutateSharesAsync(() => SharingService.UnshareAsync(Id, userId));

    private async Task MutateSharesAsync(Func<Task> mutation)
    {
        if (_sharesBusy)
        {
            return;
        }

        _sharesBusy = true;
        _shareError = null;
        try
        {
            await mutation();
        }
        catch (Exception ex) when (ex is InvalidOperationException or NoteAccessDeniedException or NoteNotFoundException)
        {
            _shareError = ex.Message;
        }

        try
        {
            _shares = await SharingService.ListSharesAsync(Id);
        }
        catch (Exception ex) when (ex is NoteAccessDeniedException or NoteNotFoundException)
        {
            _shareError ??= ex.Message;
        }
        finally
        {
            // Rebuilds each row from the model, undoing a permission select the server refused.
            _sharesVersion++;
            _sharesBusy = false;
        }
    }

    private async Task LeaveAsync()
    {
        if (_note is null || _isDeleting)
        {
            return;
        }

        // true = "Leave"; anything else (Cancel, Esc, backdrop click) keeps the share.
        var name = string.IsNullOrWhiteSpace(_note.Title) ? "Untitled note" : _note.Title;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Leave \"{name}\"?",
            "You'll lose access to this note. The owner can share it with you again.",
            yesText: "Leave",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _isDeleting = true;
        _actionError = null;
        try
        {
            await SharingService.LeaveAsync(Id);
            NavigationManager.NavigateTo("/shared");
        }
        catch (Exception ex)
        {
            _actionError = $"Couldn't leave the note: {ex.Message}";
            _isDeleting = false;
        }
    }

    private async Task TrashAsync()
    {
        if (_note is null || _isDeleting)
        {
            return;
        }

        // true = "Delete"; anything else (Cancel, Esc, backdrop click) leaves the note alone.
        var name = string.IsNullOrWhiteSpace(_note.Title) ? "Untitled note" : _note.Title;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Delete \"{name}\"?",
            "It will be moved to Trash, where you can restore it.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _isDeleting = true;
        _actionError = null;
        try
        {
            // Same soft-delete the editor's trash button does — recoverable from the Trash page.
            // No autosave to coordinate with on this page.
            await NoteService.TrashAsync(_note.Id);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _actionError = $"Couldn't delete the note: {ex.Message}";
            _isDeleting = false;
        }
    }
}
