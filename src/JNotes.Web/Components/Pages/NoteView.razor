@page "/notes/{Id:guid}"
@attribute [Authorize]
@using Microsoft.Extensions.Options
@inject INoteService NoteService
@inject NavigationManager NavigationManager
@inject IAppTimeZoneProvider TimeZoneProvider
@inject IOptions<PdfExportOptions> PdfExportOptions

<PageTitle>@(_note?.Title is { Length: > 0 } title ? title : "Note")</PageTitle>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">This note couldn't be found — it may have been deleted.</MudAlert>
    <MudButton Href="/" Variant="Variant.Outlined">Back to notes</MudButton>
}
else if (_note is null)
{
    <MudText Color="Color.Secondary">Loading…</MudText>
}
else
{
    <div class="note-view">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
            <div class="jn-title-block">
                <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-1">@(string.IsNullOrWhiteSpace(_note.Title) ? "Untitled note" : _note.Title)</MudText>
                @if (_note.Tags.Count > 0)
                {
                    <div class="jn-tags">
                        @foreach (var tag in _note.Tags)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                        }
                    </div>
                }
            </div>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="flex-shrink-0">
                <MudButton Href="@($"/notes/{_note.Id}/edit")" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                @if (PdfExportOptions.Value.IsEnabled)
                {
                    @* A plain new-tab anchor to /notes/{id}/pdf (not an @onclick): the PDF reflects the file at click time, so checklist changes made on this page are included. *@
                    <MudButton Href="@($"/notes/{_note.Id}/pdf")" Target="_blank" Rel="noopener" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.PictureAsPdf" title="Export as PDF (opens in a new tab)">Export PDF</MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Error" title="Move to Trash" Disabled="_isDeleting"
                           StartIcon="@Icons.Material.Outlined.DeleteOutline" OnClick="TrashAsync">Delete</MudButton>
            </MudStack>
        </MudStack>

        <div class="jn-meta">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled">@(_note.Type == NoteType.Checklist ? "Checklist" : "Text")</MudChip>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Last updated @TimeZoneProvider.ToAppTimeZone(_note.UpdatedAt).DateTime.ToString("g")</MudText>
        </div>

        @if (_actionError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_actionError</MudAlert>
        }

        @if (_note.Type == NoteType.Checklist)
        {
            // Checking items, adding items, and adding categories are the changes allowed from the view —
            // each goes through NoteService, never a free body edit (that stays in the editor).
            <MudPaper Outlined="true" Class="pa-3">
                <ChecklistPanel Body="@_note.Body" Disabled="_isMutating"
                                OnItemChecked="SetItemCheckedAsync" OnAddItem="AddItemAsync" OnAddCategory="AddCategoryAsync" />
            </MudPaper>
        }
        else
        {
            <MarkdownPreview Markdown="@_note.Body" />
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Note? _note;
    private bool _notFound;
    private bool _isDeleting;
    private bool _isMutating;
    private string? _actionError;

    protected override async Task OnParametersSetAsync()
    {
        _notFound = false;
        _actionError = null;
        try
        {
            _note = await NoteService.GetAsync(Id);
        }
        catch (NoteNotFoundException)
        {
            _notFound = true;
        }
    }

    private Task SetItemCheckedAsync((int LineIndex, bool IsChecked) change) =>
        MutateChecklistAsync(
            () => NoteService.SetChecklistItemCheckedAsync(Id, change.LineIndex, change.IsChecked),
            "update the checklist");

    private Task AddItemAsync((string Text, int? CategoryHeadingLine) add) =>
        MutateChecklistAsync(
            () => NoteService.AddChecklistItemAsync(Id, add.Text, add.CategoryHeadingLine),
            "add the item");

    private Task AddCategoryAsync(string name) =>
        MutateChecklistAsync(() => NoteService.AddChecklistCategoryAsync(Id, name), "add the category");

    private async Task MutateChecklistAsync(Func<Task<Note>> mutation, string action)
    {
        if (_note is null || _isMutating)
        {
            return;
        }

        // The panel disables its controls while a mutation is in flight, so two quick clicks can't
        // race each other's file write (the editor serializes through a gate for the same reason).
        _isMutating = true;
        _actionError = null;
        try
        {
            var result = await mutation();
            _note.Body = result.Body;
            _note.UpdatedAt = result.UpdatedAt;
        }
        catch (Exception ex)
        {
            _actionError = $"Couldn't {action}: {ex.Message}";
        }
        finally
        {
            _isMutating = false;
        }
    }

    private async Task TrashAsync()
    {
        if (_note is null)
        {
            return;
        }

        _isDeleting = true;
        _actionError = null;
        try
        {
            // Same soft-delete the editor's trash button does — recoverable from the Trash page,
            // so no confirmation step here either. No autosave to coordinate with on this page.
            await NoteService.TrashAsync(_note.Id);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _actionError = $"Couldn't delete the note: {ex.Message}";
            _isDeleting = false;
        }
    }
}
