@page "/notes/{Id:guid}"
@attribute [Authorize]
@inject INoteService NoteService
@inject NavigationManager NavigationManager
@inject IAppTimeZoneProvider TimeZoneProvider

<PageTitle>@(_note?.Title is { Length: > 0 } title ? title : "Note")</PageTitle>

@if (_notFound)
{
    <div class="alert alert-warning">This note couldn't be found — it may have been deleted.</div>
    <a class="btn btn-secondary" href="/">Back to notes</a>
}
else if (_note is null)
{
    <p class="text-body-secondary">Loading…</p>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div class="flex-grow-1" style="min-width: 240px;">
            <h1 class="h3 mb-1">@(string.IsNullOrWhiteSpace(_note.Title) ? "Untitled note" : _note.Title)</h1>
            @if (_note.Tags.Count > 0)
            {
                <div>
                    @foreach (var tag in _note.Tags)
                    {
                        <span class="badge text-bg-light border me-1">@tag</span>
                    }
                </div>
            }
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            <a class="btn btn-primary" href="@($"/notes/{_note.Id}/edit")">Edit</a>
            <button class="btn btn-outline-danger" type="button" title="Move to Trash" disabled="@_isDeleting" @onclick="TrashAsync">Delete</button>
        </div>
    </div>

    <p class="text-body-secondary small">
        <span class="badge text-bg-secondary me-1">@(_note.Type == NoteType.Checklist ? "Checklist" : "Text")</span>
        Last updated @TimeZoneProvider.ToAppTimeZone(_note.UpdatedAt).DateTime.ToString("g")
    </p>

    @if (_actionError is not null)
    {
        <div class="alert alert-danger">@_actionError</div>
    }

    @if (_note.Type == NoteType.Checklist)
    {
        // Checking items off and adding new ones are the changes allowed from the view — each goes
        // through NoteService (SetChecklistItemCheckedAsync / AddChecklistItemAsync), never a free
        // body edit (that stays in the editor).
        // @key/id carry _listVersion so a reorder rebuilds these rows from the model — see
        // SetItemCheckedAsync for why.
        var items = ChecklistMarkdownParser.Parse(_note.Body);
        <ul class="list-group mb-0">
            @foreach (var item in items)
            {
                <li class="list-group-item" @key="(_listVersion, item.LineIndex)">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@($"item-{_listVersion}-{item.LineIndex}")" checked="@item.IsChecked" disabled="@_isMutating"
                               @onchange="e => SetItemCheckedAsync(item.LineIndex, e.Value is bool isChecked && isChecked)" />
                        <label class="form-check-label @(item.IsChecked ? "text-decoration-line-through text-body-secondary" : "")"
                               for="@($"item-{_listVersion}-{item.LineIndex}")">
                            @item.Text
                        </label>
                    </div>
                </li>
            }
            @if (items.Count == 0)
            {
                <li class="list-group-item text-body-secondary">No items yet — add one below.</li>
            }
        </ul>
        <div class="input-group mt-3">
            <input class="form-control" placeholder="Add an item" aria-label="Add a checklist item"
                   value="@_newItemText" @oninput="OnNewItemInput" @onkeydown="OnNewItemKeyDownAsync"
                   disabled="@_isMutating" @ref="_newItemInput" />
            <button class="btn btn-outline-primary" type="button"
                    disabled="@(_isMutating || string.IsNullOrWhiteSpace(_newItemText))"
                    @onclick="AddItemAsync">Add</button>
        </div>
    }
    else
    {
        <MarkdownPreview Markdown="@_note.Body" />
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Note? _note;
    private bool _notFound;
    private bool _isDeleting;
    private bool _isMutating;
    private int _listVersion;
    private string _newItemText = "";
    private ElementReference _newItemInput;
    private string? _actionError;

    protected override async Task OnParametersSetAsync()
    {
        _notFound = false;
        _actionError = null;
        try
        {
            _note = await NoteService.GetAsync(Id);
        }
        catch (NoteNotFoundException)
        {
            _notFound = true;
        }
    }

    private async Task SetItemCheckedAsync(int lineIndex, bool isChecked)
    {
        if (_note is null || _isMutating)
        {
            return;
        }

        // Inputs are disabled while a mutation is in flight, so two quick clicks can't race each
        // other's file write (the editor serializes through a gate for the same reason).
        _isMutating = true;
        _actionError = null;
        try
        {
            var result = await NoteService.SetChecklistItemCheckedAsync(_note.Id, lineIndex, isChecked);
            _note.Body = result.Body;
            _note.UpdatedAt = result.UpdatedAt;

            // Checking an item moves it, so the row that takes its old slot can render identically
            // to what the browser already toggled — Blazor's diff would then skip patching it and
            // leave the DOM checkbox ticked. Bumping the version changes every row's key and id,
            // forcing a rebuild from the model.
            _listVersion++;
        }
        catch (Exception ex)
        {
            _actionError = $"Couldn't update the checklist: {ex.Message}";
        }
        finally
        {
            _isMutating = false;
        }
    }

    private void OnNewItemInput(ChangeEventArgs e) => _newItemText = e.Value?.ToString() ?? "";

    private async Task OnNewItemKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddItemAsync();
        }
    }

    private async Task AddItemAsync()
    {
        if (_note is null || _isMutating || string.IsNullOrWhiteSpace(_newItemText))
        {
            return;
        }

        _isMutating = true;
        _actionError = null;
        var added = false;
        try
        {
            var result = await NoteService.AddChecklistItemAsync(_note.Id, _newItemText);
            _note.Body = result.Body;
            _note.UpdatedAt = result.UpdatedAt;
            _newItemText = "";
            _listVersion++;
            added = true;
        }
        catch (Exception ex)
        {
            _actionError = $"Couldn't add the item: {ex.Message}";
        }
        finally
        {
            _isMutating = false;
        }

        if (added)
        {
            // The input was disabled during the add, which drops focus — put it back so several
            // items can be typed in a row. Needs a render first so the input is enabled again.
            await InvokeAsync(StateHasChanged);
            await _newItemInput.FocusAsync();
        }
    }

    private async Task TrashAsync()
    {
        if (_note is null)
        {
            return;
        }

        _isDeleting = true;
        _actionError = null;
        try
        {
            // Same soft-delete the editor's trash button does — recoverable from the Trash page,
            // so no confirmation step here either. No autosave to coordinate with on this page.
            await NoteService.TrashAsync(_note.Id);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _actionError = $"Couldn't delete the note: {ex.Message}";
            _isDeleting = false;
        }
    }
}
