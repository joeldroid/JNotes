@page "/profile"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject IUserRepository UserRepository
@inject IUserManagementService UserManagementService
@inject ICurrentUserContext CurrentUser
@inject NavigationManager NavigationManager

<PageTitle>My Profile</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">My Profile</MudText>

@if (_user is null)
{
    <MudText Color="Color.Secondary">Loading…</MudText>
}
else
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="jn-form-narrow">
        <DataAnnotationsValidator />
        <MudStack Spacing="2">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

            <MudText>
                <strong>Username:</strong> @_user.Username
                <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">(username can't be changed here)</MudText>
            </MudText>

            <MudTextField @bind-Value="_model.FirstName" Label="First name" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_model.LastName" Label="Last name" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Disabled="@(!_canEditEmail)"
                          HelperText="@(_canEditEmail ? null : "Only an admin can change your email.")" />

            <div>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" Disabled="_isSaving">
                    @(_isSaving ? "Saving…" : "Save")
                </MudButton>
            </div>
        </MudStack>
    </EditForm>
}

@code {
    private UserAccount? _user;
    private ProfileModel _model = new();
    private bool _canEditEmail;
    private bool _isSaving;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _user = await UserRepository.GetUserByIdAsync(CurrentUser.UserId);
        if (_user is null)
        {
            return;
        }

        _canEditEmail = _user.Role == UserRole.Admin;
        _model = new ProfileModel
        {
            FirstName = _user.FirstName ?? "",
            LastName = _user.LastName ?? "",
            Email = _user.Email ?? "",
        };
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _error = null;

        var firstName = string.IsNullOrWhiteSpace(_model.FirstName) ? null : _model.FirstName.Trim();
        var lastName = string.IsNullOrWhiteSpace(_model.LastName) ? null : _model.LastName.Trim();
        // If email isn't editable, send back exactly what's already on the account rather than the
        // (disabled, but still present) input's value — belt-and-suspenders alongside the
        // server-side check in IUserManagementService, not a substitute for it.
        var email = _canEditEmail
            ? (string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email.Trim())
            : _user!.Email;

        try
        {
            await UserManagementService.UpdateProfileAsync(CurrentUser.UserId, CurrentUser.UserId, firstName, lastName, email);

            // Forced full reload so NavMenu's "Signed in as" (which reads the freshly-saved first
            // name) refreshes immediately — it's part of MainLayout, a sibling that a normal
            // in-circuit re-render of this page alone wouldn't touch.
            NavigationManager.NavigateTo("/profile", forceLoad: true);
        }
        catch (DuplicateEmailException)
        {
            _error = $"Email '{email}' is already in use by another account.";
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private sealed class ProfileModel
    {
        public string FirstName { get; set; } = "";

        public string LastName { get; set; } = "";

        public string Email { get; set; } = "";
    }
}
